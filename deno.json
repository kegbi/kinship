{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "lineWidth": 80,
    "exclude": [
      "apps/web/.astro/",
      "apps/web/dist/",
      "docs/planning/tickets/",
      "packages/contracts/generated/"
    ],
    "include": [
      "AGENTS.md",
      "README.md",
      "apps/",
      "compose.schema-test.yaml",
      "deno.json",
      ".agents/skills/run-tdd-ticket-loop/",
      ".codex/agents/",
      ".github/workflows/",
      "docs/",
      "eslint.config.js",
      "lefthook.yml",
      "packages/",
      "playwright.config.ts",
      "tests/",
      "tools/",
      "vitest.config.ts"
    ]
  },
  "lint": {
    "include": [
      "apps/",
      "packages/",
      "playwright.config.ts",
      "tests/",
      "tools/",
      "vitest.config.ts"
    ],
    "rules": {
      "tags": ["recommended"],
      "include": ["eqeqeq"]
    }
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "fix": "deno fmt",
    "lint": "DENO_NO_PACKAGE_JSON=1 deno lint && pnpm exec eslint apps/web/src",
    "check": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts check",
    "check:architecture": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts architecture",
    "build": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts build",
    "dev": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read=.env --allow-env=POSTGRES_DB,POSTGRES_PASSWORD,POSTGRES_PORT,POSTGRES_USER,API_PORT,WEB_PORT,SMTP_PORT,OBJECT_STORAGE_ACCESS_KEY,OBJECT_STORAGE_BUCKET,OBJECT_STORAGE_CONSOLE_PORT,OBJECT_STORAGE_PORT,OBJECT_STORAGE_REQUEST_TIMEOUT_MS,OBJECT_STORAGE_SECRET_KEY,AUTH_MFA_ENCRYPTION_KEYSET,AUTH_MINIMUM_RESPONSE_MS,AUTH_THROTTLE_SUBJECT_KEYSET,INTEGRATIONS_DAV_ENABLED,INTEGRATIONS_ENCRYPTION_KEYSET --allow-net=127.0.0.1 --allow-run=deno,docker tools/dev.ts",
    "dev:api": "DENO_NO_PACKAGE_JSON=1 deno run --allow-env=READABLE_STREAM,APP_ENV,AUTH_MFA_ENCRYPTION_KEYSET,AUTH_MINIMUM_RESPONSE_MS,AUTH_THROTTLE_SUBJECT_KEYSET,INTEGRATIONS_DAV_ENABLED,INTEGRATIONS_ENCRYPTION_KEYSET,DATABASE_URL,HOST,PORT,PUBLIC_WEB_ORIGIN,SMTP_FROM,SMTP_HOST,SMTP_PASSWORD,SMTP_PORT,SMTP_SECURITY,SMTP_USERNAME,OBJECT_STORAGE_ACCESS_KEY,OBJECT_STORAGE_BUCKET,OBJECT_STORAGE_HOST,OBJECT_STORAGE_PORT,OBJECT_STORAGE_REQUEST_TIMEOUT_MS,OBJECT_STORAGE_SECRET_KEY,OBJECT_STORAGE_USE_SSL,PGHOST,PGPORT,PGUSERNAME,PGUSER,PGDATABASE,PGPASSWORD,PGMAX,PGSSL,PGSSLNEGOTIATION,PGIDLE_TIMEOUT,PGCONNECT_TIMEOUT,PGMAX_LIFETIME,PGMAX_PIPELINE,PGBACKOFF,PGKEEP_ALIVE,PGPREPARE,PGDEBUG,PGFETCH_TYPES,PGPUBLICATIONS,PGAPPNAME,PGTARGETSESSIONATTRS,PGTARGET_SESSION_ATTRS --allow-net=127.0.0.1 apps/api/main.ts",
    "dev:web": "ASTRO_DEV_BACKGROUND=0 pnpm exec astro dev --root apps/web",
    "contracts:generate": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read=packages/contracts --allow-write=packages/contracts tools/contracts/generate.ts",
    "contracts:check": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read=packages/contracts tools/contracts/generate.ts --check",
    "migration:apply": "DENO_NO_PACKAGE_JSON=1 deno run --allow-env=DATABASE_URL,PGHOST,PGPORT,PGUSERNAME,PGUSER,PGDATABASE,PGPASSWORD,PGMAX,PGSSL,PGSSLNEGOTIATION,PGIDLE_TIMEOUT,PGCONNECT_TIMEOUT,PGMAX_LIFETIME,PGMAX_PIPELINE,PGBACKOFF,PGKEEP_ALIVE,PGPREPARE,PGDEBUG,PGFETCH_TYPES,PGPUBLICATIONS,PGAPPNAME,PGTARGETSESSIONATTRS,PGTARGET_SESSION_ATTRS --allow-net --allow-read=personal-crm-schema/v1,personal-crm-schema/v2,personal-crm-schema/v3,personal-crm-schema/v4,personal-crm-schema/v5,personal-crm-schema/v6,personal-crm-schema/v7 tools/migrations/main.ts",
    "deps:deno": "DENO_NO_PACKAGE_JSON=1 deno install --frozen --node-modules-dir=none",
    "deps:node": "pnpm install --frozen-lockfile",
    "deps:audit": "DENO_NO_PACKAGE_JSON=1 deno audit",
    "test": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts all",
    "test:unit": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts unit",
    "test:integration": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts integration",
    "test:contract": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts contract",
    "test:coverage": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts coverage",
    "test:e2e": "DENO_NO_PACKAGE_JSON=1 deno run --unsafely-ignore-certificate-errors=127.0.0.1 --allow-net=127.0.0.1 --allow-run=docker,pnpm,deno,powershell,pwsh,ps,kill --allow-write=.artifacts/playwright/.last-run.json tools/e2e.ts",
    "test:schema": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read=personal-crm-schema/v1,personal-crm-schema/v2,personal-crm-schema/v3,personal-crm-schema/v4,personal-crm-schema/v5,personal-crm-schema/v6,personal-crm-schema/v7 --allow-run=docker tools/schema/validate_postgres.ts",
    "test:schema:matrix": "deno task test:schema && deno task test:schema --postgres-image postgres:17.10-alpine3.23@sha256:8189a1f6e40904781fc9e2612687877791d21679866db58b1de996b31fc312e4",
    "test:repro:astro-readiness": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts unit --module=repro-astro-readiness",
    "ops": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read --allow-run=deno,docker,pnpm tools/tasks/run.ts ops"
  },
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@0.4.0",
    "@standard-schema/spec": "npm:@standard-schema/spec@1.1.0",
    "@std/yaml": "jsr:@std/yaml@1.2.0",
    "hono": "npm:hono@4.13.1",
    "kysely": "npm:kysely@0.29.4",
    "kysely-postgres-js": "npm:kysely-postgres-js@3.0.0",
    "postgres": "npm:postgres@3.4.9",
    "minio": "npm:minio@8.0.7",
    "zod": "npm:zod@4.4.3"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "coverage": {
    "thresholds": {
      "branches": 80,
      "functions": 80,
      "lines": 80
    }
  },
  "minimumDependencyAge": "PT72H",
  "allowScripts": []
}
