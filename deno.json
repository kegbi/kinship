{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "lineWidth": 80,
    "include": [
      "AGENTS.md",
      "compose.schema-test.yaml",
      "deno.json",
      ".agents/skills/run-tdd-ticket-loop/",
      ".codex/agents/",
      "docs/",
      "tools/"
    ]
  },
  "lint": {
    "include": ["tools/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["eqeqeq"]
    }
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check tools/schema/validate_postgres.ts tools/workflows/ticket_contract.ts tools/workflows/validate_ticket.ts",
    "ticket:validate": "deno run --allow-read --allow-run=git tools/workflows/validate_ticket.ts",
    "test:workflow": "deno test --allow-read --allow-write --allow-run=deno,git tools/workflows",
    "test:workflow:coverage": "deno test --allow-read --allow-write --allow-run=deno,git --coverage=.coverage/workflows --clean tools/workflows && deno coverage --detailed --threshold=100 --include=\"tools/workflows/(ticket_contract|validate_ticket)\\.ts$\" .coverage/workflows",
    "test:schema": "deno run --allow-read=personal-crm-schema/v1 --allow-run=docker tools/schema/validate_postgres.ts",
    "test:schema:compat": "deno task test:schema --postgres-image postgres:17.10-alpine3.23",
    "test:schema:matrix": "deno task test:schema && deno task test:schema:compat"
  },
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@0.4.0",
    "@standard-schema/spec": "npm:@standard-schema/spec@1.1.0",
    "hono": "npm:hono@4.13.1",
    "kysely": "npm:kysely@0.29.4",
    "kysely-postgres-js": "npm:kysely-postgres-js@3.0.0",
    "postgres": "npm:postgres@3.4.9",
    "zod": "npm:zod@4.4.3"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "minimumDependencyAge": "PT72H",
  "allowScripts": []
}
