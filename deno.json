{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "lineWidth": 80,
    "exclude": [
      "apps/web/.astro/",
      "apps/web/dist/",
      "docs/planning/tickets/"
    ],
    "include": [
      "AGENTS.md",
      "README.md",
      "apps/",
      "compose.schema-test.yaml",
      "deno.json",
      ".agents/skills/run-tdd-ticket-loop/",
      ".codex/agents/",
      "docs/",
      "eslint.config.js",
      "packages/",
      "playwright.config.ts",
      "tests/",
      "tools/",
      "vitest.config.ts"
    ]
  },
  "lint": {
    "include": [
      "apps/",
      "packages/",
      "playwright.config.ts",
      "tests/",
      "tools/",
      "vitest.config.ts"
    ],
    "rules": {
      "tags": ["recommended"],
      "include": ["eqeqeq"]
    }
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "fix": "deno fmt",
    "lint": "DENO_NO_PACKAGE_JSON=1 deno lint && pnpm exec eslint apps/web/src",
    "check:api": "DENO_NO_PACKAGE_JSON=1 deno check apps/api/main.ts apps/api/app_test.ts packages/contracts/health_test.ts",
    "check:web": "pnpm exec astro check --root apps/web",
    "check:dev-tool": "DENO_NO_PACKAGE_JSON=1 deno check tools/dev.ts",
    "check:schema-tool": "DENO_NO_PACKAGE_JSON=1 deno check tools/schema/validate_postgres.ts",
    "check": "deno task check:api && deno task check:web && deno task check:dev-tool && deno task check:schema-tool",
    "dev:api": "DENO_NO_PACKAGE_JSON=1 deno run --allow-env=PORT --allow-net=127.0.0.1 apps/api/main.ts",
    "dev:web": "ASTRO_DEV_BACKGROUND=0 pnpm exec astro dev --root apps/web",
    "dev": "DENO_NO_PACKAGE_JSON=1 deno run --allow-run=deno tools/dev.ts",
    "build:api": "DENO_NO_PACKAGE_JSON=1 deno check apps/api/main.ts",
    "build:web": "pnpm exec astro build --root apps/web",
    "build": "deno task build:api && deno task build:web",
    "test:unit": "pnpm exec vitest run",
    "test:contract": "DENO_NO_PACKAGE_JSON=1 deno test apps/api/app_test.ts packages/contracts/health_test.ts",
    "test": "deno task test:contract && deno task test:unit",
    "test:coverage:api": "DENO_NO_PACKAGE_JSON=1 deno test --clean --coverage=.coverage/deno apps/api/app_test.ts packages/contracts/health_test.ts && deno coverage --include='apps/api|packages/contracts' --threshold=80 .coverage/deno",
    "test:coverage:web": "pnpm exec vitest run --coverage",
    "test:coverage": "deno task test:coverage:api && deno task test:coverage:web",
    "test:e2e": "pnpm exec playwright test --project=chromium",
    "deps:deno": "DENO_NO_PACKAGE_JSON=1 deno install --frozen --node-modules-dir=none",
    "deps:deno:offline": "DENO_NO_PACKAGE_JSON=1 deno install --frozen --cached-only --node-modules-dir=none",
    "deps:node": "pnpm install --frozen-lockfile",
    "deps:node:offline": "pnpm install --offline --frozen-lockfile",
    "deps": "deno task deps:deno && deno task deps:node",
    "test:schema": "DENO_NO_PACKAGE_JSON=1 deno run --allow-read=personal-crm-schema/v1 --allow-run=docker tools/schema/validate_postgres.ts",
    "test:schema:compat": "deno task test:schema --postgres-image postgres:17.10-alpine3.23@sha256:8189a1f6e40904781fc9e2612687877791d21679866db58b1de996b31fc312e4",
    "test:schema:matrix": "deno task test:schema && deno task test:schema:compat"
  },
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@0.4.0",
    "@standard-schema/spec": "npm:@standard-schema/spec@1.1.0",
    "hono": "npm:hono@4.13.1",
    "kysely": "npm:kysely@0.29.4",
    "kysely-postgres-js": "npm:kysely-postgres-js@3.0.0",
    "postgres": "npm:postgres@3.4.9",
    "zod": "npm:zod@4.4.3"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "coverage": {
    "thresholds": {
      "branches": 80,
      "functions": 80,
      "lines": 80
    }
  },
  "minimumDependencyAge": "PT72H",
  "allowScripts": []
}
