FROM denoland/deno:debian-2.9.5@sha256:b429777c3dcff34a6488f365a1537db1640b2d48379b60f5e6206be034472463

WORKDIR /app
ENV DENO_NO_PACKAGE_JSON=1
COPY --chown=deno:deno deno.json deno.lock package.json ./
COPY --chown=deno:deno apps/api ./apps/api
COPY --chown=deno:deno apps/worker ./apps/worker
COPY --chown=deno:deno packages ./packages
COPY --chown=deno:deno tools/migrations ./tools/migrations
COPY --chown=deno:deno tools/operations/private_production_preflight.ts tools/operations/private_production_probe.ts tools/operations/dokploy_preflight.ts ./tools/operations/
COPY --chown=deno:deno docs/planning/private-production-profile.json docs/planning/mvp-capacity-profile.json ./docs/planning/
COPY --chown=deno:deno personal-crm-schema/v1/personal_crm_rewrite_schema_v3.sql ./personal-crm-schema/v1/personal_crm_rewrite_schema_v3.sql
COPY --chown=deno:deno personal-crm-schema/v2 ./personal-crm-schema/v2
COPY --chown=deno:deno personal-crm-schema/v3 ./personal-crm-schema/v3
COPY --chown=deno:deno personal-crm-schema/v4 ./personal-crm-schema/v4
COPY --chown=deno:deno personal-crm-schema/v5 ./personal-crm-schema/v5
COPY --chown=deno:deno personal-crm-schema/v6 ./personal-crm-schema/v6
COPY --chown=deno:deno personal-crm-schema/v7 ./personal-crm-schema/v7
COPY --chown=deno:deno personal-crm-schema/v8 ./personal-crm-schema/v8
COPY --chown=deno:deno personal-crm-schema/v9 ./personal-crm-schema/v9
COPY --chown=deno:deno personal-crm-schema/v10 ./personal-crm-schema/v10
COPY --chown=deno:deno personal-crm-schema/v11 ./personal-crm-schema/v11

USER deno
RUN DENO_NO_PACKAGE_JSON=1 deno install --frozen --node-modules-dir=none --entrypoint apps/api/main.ts apps/worker/main.ts tools/migrations/main.ts

CMD ["deno", "run", "--allow-env=READABLE_STREAM,APP_ENV,AUTH_MFA_ENCRYPTION_KEYSET,AUTH_MINIMUM_RESPONSE_MS,AUTH_THROTTLE_SUBJECT_KEYSET,INTEGRATIONS_DAV_ENABLED,INTEGRATIONS_ENCRYPTION_KEYSET,DATABASE_URL,HOST,PORT,PUBLIC_WEB_ORIGIN,SMTP_FROM,SMTP_HOST,SMTP_PASSWORD,SMTP_PORT,SMTP_SECURITY,SMTP_USERNAME,OBJECT_STORAGE_ACCESS_KEY,OBJECT_STORAGE_BUCKET,OBJECT_STORAGE_HOST,OBJECT_STORAGE_PORT,OBJECT_STORAGE_REQUEST_TIMEOUT_MS,OBJECT_STORAGE_SECRET_KEY,OBJECT_STORAGE_USE_SSL,PGHOST,PGPORT,PGUSERNAME,PGUSER,PGDATABASE,PGPASSWORD,PGMAX,PGSSL,PGSSLNEGOTIATION,PGIDLE_TIMEOUT,PGCONNECT_TIMEOUT,PGMAX_LIFETIME,PGMAX_PIPELINE,PGBACKOFF,PGKEEP_ALIVE,PGPREPARE,PGDEBUG,PGFETCH_TYPES,PGPUBLICATIONS,PGAPPNAME,PGTARGETSESSIONATTRS,PGTARGET_SESSION_ATTRS", "--allow-net", "apps/api/main.ts"]
