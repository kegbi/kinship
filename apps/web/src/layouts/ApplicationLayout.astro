---
import "../styles/application.css";

interface Props {
  readonly current: "journal" | "people" | "settings" | "tasks" | "today";
  readonly description: string;
  readonly pageId:
    | "app.today"
    | "compliance.accept"
    | "journal.index"
    | "journal.item"
    | "people.archived"
    | "people.create"
    | "people.activity-report"
    | "people.audit"
    | "people.index"
    | "people.profile"
    | "settings.index"
    | "settings.audit"
    | "settings.members"
    | "settings.personalization"
    | "settings.preferences"
    | "settings.profile"
    | "settings.security"
    | "settings.storage"
    | "settings.import"
    | "settings.import-new"
    | "settings.import-report"
    | "settings.export"
    | "settings.workspace"
    | "tasks.index";
  readonly title: string;
}

const { current, description, pageId, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f4f0e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body data-page-id={pageId}>
    <a class="skip-link" href="#main-content" tabindex="0">Skip to main content</a>
    <section id="access-state" class="access-state" role="status" tabindex="-1" aria-live="polite">
      <div class="access-card">
        <p class="eyebrow">Protected workspace</p>
        <h1>Opening Kinship…</h1>
        <p>Resolving your secure session and active workspace.</p>
      </div>
    </section>

    <div id="protected-shell" class="application" hidden>
      <header class="app-header">
        <div class="header-row">
          <a class="brand" href="/app" aria-label="Kinship Today" tabindex="0">
            <span class="brand-mark" aria-hidden="true">K</span>
            <span>Kinship</span>
          </a>

          <nav class="primary-nav" aria-label="Primary navigation">
            <a href="/app" tabindex="0" aria-current={current === "today" ? "page" : undefined}>Today</a>
            <a href="/app/people" tabindex="0" aria-current={current === "people" ? "page" : undefined}>People</a>
            <a href="/app/tasks" tabindex="0" aria-current={current === "tasks" ? "page" : undefined}>Tasks</a>
            <a href="/app/journal" tabindex="0" aria-current={current === "journal" ? "page" : undefined}>Journal</a>
          </nav>

          <div class="global-actions" aria-label="Workspace actions">
            <button class="add-action" data-quick-capture type="button">Quick capture</button>
            <a class="add-action" href="/app/people/new" tabindex="0">Add person</a>
            <div class="member-menu" role="group" aria-label="Member menu">
              <button id="member-menu-toggle" type="button" aria-label="Open member menu" aria-expanded="false" aria-controls="member-popover">Member menu</button>
              <div id="member-popover" class="member-popover" hidden>
                <p class="menu-workspace"><span>Active workspace</span><strong data-workspace-name></strong></p>
                <span class="menu-item unavailable" aria-disabled="true">Profile <small>Available from settings</small></span>
                <a class="menu-item" href="/app/settings" tabindex="0" aria-current={current === "settings" ? "page" : undefined}>Settings</a>
                <span class="menu-item unavailable" aria-disabled="true">Help &amp; what's new <small>Support is being prepared</small></span>
              </div>
              <p id="shell-status" class="sr-status" role="status" tabindex="-1" aria-live="polite"></p>
              <button id="member-sign-out" class="direct-sign-out" type="button">Sign out</button>
            </div>
          </div>
        </div>

        <div id="workspace-switcher-container" class="workspace-switcher" hidden>
          <label for="workspace-switcher">Active workspace</label>
          <select id="workspace-switcher"></select>
        </div>
      </header>
      <slot />

      <dialog id="interaction-capture-dialog" class="interaction-capture-dialog" aria-labelledby="interaction-capture-heading">
        <form id="interaction-capture-form" method="dialog" novalidate>
          <header>
            <p class="section-kicker">Quick capture</p>
            <h2 id="interaction-capture-heading">Record an activity or note</h2>
          </header>
          <label>
            What are you recording?
            <select name="kind">
              <option value="activity">Activity</option>
              <option value="note">Note</option>
            </select>
          </label>
          <label for="interaction-participant-search">Search participants</label>
          <input id="interaction-participant-search" name="participantSearch" type="search" maxlength="200" placeholder="Search people" autocomplete="off" />
          <label for="interaction-participants">Participants</label>
          <select id="interaction-participants" name="participantIds" multiple required size="5" aria-describedby="interaction-participants-hint"></select>
          <button data-participants-more class="button-secondary" type="button" hidden>Load more people</button>
          <p id="interaction-participants-hint" class="form-hint">Choose up to 50 people. Notes belong to one selected person.</p>
          <label data-interaction-occurrence>
            When it happened
            <input name="happenedAt" type="datetime-local" required aria-describedby="interaction-happened-at-error" />
          </label>
          <small id="interaction-happened-at-error" class="field-error"></small>
          <div data-interaction-kind="activity">
            <label>Summary <input name="summary" maxlength="500" required /></label>
            <label for="interaction-activity-type-search">Search activity types</label>
            <input id="interaction-activity-type-search" name="activityTypeSearch" type="search" maxlength="100" placeholder="Search categories" autocomplete="off" />
            <label for="interaction-activity-type">Activity type</label>
            <select id="interaction-activity-type" name="activityTypeId"><option value="">No category</option></select>
            <button data-activity-types-more class="button-secondary" type="button" hidden>Load more categories</button>
            <label>Details (optional) <textarea name="description" maxlength="10000" rows="4"></textarea></label>
            <label for="interaction-emotion-search">Search emotions</label>
            <input id="interaction-emotion-search" name="emotionSearch" type="search" maxlength="100" placeholder="Search emotions" autocomplete="off" />
            <label for="interaction-emotions">Emotions (optional)</label>
            <select id="interaction-emotions" name="emotionIds" multiple size="4"></select>
            <button data-emotions-more class="button-secondary" type="button" hidden>Load more emotions</button>
          </div>
          <div data-interaction-kind="note" hidden>
            <label>Note <textarea name="body" maxlength="10000" rows="5"></textarea></label>
            <label class="checkbox-row"><input name="isFavorited" type="checkbox" /> Keep this note in Today favorites</label>
          </div>
          <p id="interaction-capture-status" class="section-state" role="status" aria-live="polite"></p>
          <div class="form-actions">
            <button class="button-primary" type="submit">Save interaction</button>
            <button data-interaction-cancel type="button">Cancel</button>
          </div>
        </form>
      </dialog>
    </div>
  </body>
</html>

<script>
  import { mountApplicationShell } from "../lib/app-shell.ts";
  import { mountInteractionCapture } from "../lib/interactions.ts";
  void mountApplicationShell();
  void mountInteractionCapture();
</script>
