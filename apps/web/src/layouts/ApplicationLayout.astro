---
// The shared stylesheets come first, so they load before the page group's
// stylesheet each page imports right after this layout (FER-09).
import "../styles/application.css";
import "../styles/islands.css";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";
import {
  buttonVariants,
  skeletonLinesVariants,
  skeletonVariants,
} from "../components/ui/variants.ts";
import {
  ACCESS_FORBIDDEN_TEMPLATE_ID,
  ACCESS_SIGN_IN_TEMPLATE_ID,
  ACCESS_UNAVAILABLE_TEMPLATE_ID,
  TOAST_TEMPLATE_ID,
  WORKSPACE_OPTION_TEMPLATE_ID,
} from "../features/shell/templates.ts";

interface Props {
  readonly current: "journal" | "people" | "settings" | "tasks" | "today";
  readonly description: string;
  readonly pageId:
    | "app.today"
    | "compliance.accept"
    | "journal.index"
    | "journal.item"
    | "people.archived"
    | "people.create"
    | "people.activity-report"
    | "people.audit"
    | "people.index"
    | "people.profile"
    | "settings.index"
    | "settings.audit"
    | "settings.api-access"
    | "settings.integrations"
    | "settings.members"
    | "settings.personalization"
    | "settings.preferences"
    | "settings.profile"
    | "settings.security"
    | "settings.storage"
    | "settings.import"
    | "settings.import-new"
    | "settings.import-report"
    | "settings.export"
    | "settings.workspace"
    | "settings.workspace-danger"
    | "tasks.index";
  readonly title: string;
}

const { current, description, pageId, title } = Astro.props;
const accessAction = buttonVariants({
  className: "mt-(--space-4)",
  shape: "pill",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ThemeBootstrap />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body data-page-id={pageId}>
    <a class="skip-link" href="#main-content" tabindex="0">Skip to main content</a>
    <section id="access-state" class="access-state" role="status" tabindex="-1" aria-live="polite">
      {/* While the session resolves, the page keeps the shell's frame: a
        header in the same place and skeletons where the content will be, so
        opening a page never flashes a full-screen loader. */}
      <div class="access-skeleton" aria-hidden="true">
        <div class="access-skeleton-header">
          <div class="access-skeleton-row">
            <span class="access-skeleton-brand"><span class="access-skeleton-mark">K</span><span>Kinship</span></span>
            <span class="access-skeleton-nav"><span class={skeletonVariants({ shape: "chip" })}></span><span class={skeletonVariants({ shape: "chip" })}></span><span class={skeletonVariants({ shape: "chip" })}></span><span class={skeletonVariants({ shape: "chip" })}></span></span>
          </div>
        </div>
        <div class="access-skeleton-page">
          <div class={skeletonLinesVariants}><span class={skeletonVariants({ shape: "line-60" })}></span><span class={skeletonVariants({ shape: "line-80" })}></span></div>
          <div class="access-skeleton-card"><div class={skeletonLinesVariants}><span class={skeletonVariants({ shape: "line-60" })}></span><span class={skeletonVariants()}></span><span class={skeletonVariants({ shape: "line-80" })}></span></div></div>
          <div class="access-skeleton-card"><div class={skeletonLinesVariants}><span class={skeletonVariants({ shape: "line-60" })}></span><span class={skeletonVariants()}></span><span class={skeletonVariants({ shape: "line-80" })}></span></div></div>
        </div>
      </div>
      <div class="access-card">
        <p class="eyebrow">Protected workspace</p>
        <h1>Opening Kinship…</h1>
        <p>Resolving your secure session and active workspace.</p>
      </div>
    </section>
    {/* The access state's answers, cloned by features/shell/application-shell/application-shell.ts. */}
    <template id={ACCESS_SIGN_IN_TEMPLATE_ID}><h1>Sign in to Kinship</h1><p>Your session is missing, expired, revoked, or no longer active in this workspace.</p><a class={accessAction} href="/auth/sign-in">Go to sign-in</a></template>
    <template id={ACCESS_UNAVAILABLE_TEMPLATE_ID}><h1>Kinship is temporarily unavailable</h1><p>We could not confirm your active workspace. Any saved workspace choice is unchanged.</p><button class={accessAction} type="button">Try again</button></template>
    <template id={ACCESS_FORBIDDEN_TEMPLATE_ID}><main id="forbidden-main-content" tabindex="-1"><h1>You don’t have access to Members</h1><p>Only workspace owners and admins can view members and invitations.</p><a class={accessAction} href="/app/settings">Return to settings</a></main></template>

    <div id="protected-shell" class="application" hidden>
      <header class="app-header">
        <div class="header-row">
          <a class="brand" href="/app" aria-label="Kinship Today" tabindex="0">
            <span class="brand-mark" aria-hidden="true">K</span>
            <span>Kinship</span>
          </a>

          <nav class="primary-nav" aria-label="Primary navigation">
            <a href="/app" tabindex="0" aria-current={current === "today" ? "page" : undefined}>Today</a>
            <a href="/app/people" tabindex="0" aria-current={current === "people" ? "page" : undefined}>People</a>
            <a href="/app/tasks" tabindex="0" aria-current={current === "tasks" ? "page" : undefined}>Tasks</a>
            <a href="/app/journal" tabindex="0" aria-current={current === "journal" ? "page" : undefined}>Journal</a>
          </nav>

          <div class="global-search" data-global-people-search>
            <input id="global-people-search-input" class="global-people-search-input" type="search" role="combobox" aria-label="Find a person" aria-expanded="false" aria-controls="global-people-search-dialog" placeholder="Search people, notes, tasks…" autocomplete="off" maxlength="200" />
            <button class={buttonVariants({ className: "global-people-search-open", variant: "outline" })} data-global-people-search-open type="button" aria-label="Find a person" aria-expanded="false" aria-controls="global-people-search-dialog">
              <span>Search</span>
            </button>
          </div>

          <div class="global-actions" aria-label="Workspace actions">
            <button class="add-action" data-quick-capture data-interaction-capture-ready="false" type="button" aria-label="Quick capture" disabled><span class="desktop-action-label">Quick capture</span><span class="compact-action-label">Capture</span></button>
            <a class="add-action" href="/app/people/new" tabindex="0">Add person</a>
            <button class="theme-toggle" data-theme-toggle data-theme-choice="system" type="button" aria-label="Theme" title="Theme" disabled><svg class="theme-toggle-glyph" data-theme-glyph="system" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2" /><path d="M8 21h8M12 17v4" /></svg><svg class="theme-toggle-glyph" data-theme-glyph="light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg><svg class="theme-toggle-glyph" data-theme-glyph="dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg></button>
            <div class="member-menu" role="group" aria-label="Member menu">
              <button id="member-menu-toggle" type="button" aria-label="Open member menu" aria-expanded="false" aria-controls="member-popover"><span class="desktop-action-label">Member menu</span><span class="compact-action-label">Menu</span></button>
              <div id="member-popover" class="member-popover" hidden>
                <div class="menu-workspace">
                  <label for="workspace-switcher">Active workspace</label>
                  <strong data-workspace-name></strong>
                  <div id="workspace-switcher-container" class="workspace-switcher" hidden>
                    <select id="workspace-switcher"></select>
                    <template id={WORKSPACE_OPTION_TEMPLATE_ID}><option></option></template>
                  </div>
                </div>
                <a class="menu-item compact-add-person" href="/app/people/new" tabindex="0">Add person</a>
                <a class="menu-item" href="/app/settings/profile" tabindex="0" aria-current={pageId === "settings.profile" ? "page" : undefined}>Profile</a>
                <a class="menu-item" href="/app/settings" tabindex="0" aria-current={current === "settings" && pageId !== "settings.profile" ? "page" : undefined}>Settings</a>
                <button id="member-sign-out" class="direct-sign-out" type="button">Sign out</button>
              </div>
            </div>
            {/* The notification bell (features/shell/notifications/, GAP-053), last in the
              header's tab order so the shell's order before it is unchanged. Its
              button stays disabled until the session is ready; then
              notification-count.ts keeps its badge and name, and its first click
              loads the panel's island over it (FER-01). */}
            <div class="notification-bell" data-notification-bell><button class="notification-bell-button" type="button" aria-label="Notifications" disabled><svg class="notification-bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.268 21a2 2 0 0 0 3.464 0" /><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></svg><span class="desktop-action-label">Notifications</span><span class="notification-bell-badge" aria-hidden="true" hidden></span></button></div>
          </div>
        </div>
      </header>
      <slot />

      {/* Quick capture (features/interactions/) renders its dialog through a
        portal; this root carries the island's readiness marker. */}
      <div class="contents" data-quick-capture-root></div>
      <ul id="app-toasts" class="app-toasts" aria-live="polite" aria-label="Notifications"></ul><template id={TOAST_TEMPLATE_ID}><li class="app-toast"><p class="app-toast-message"></p><button class="app-toast-action" type="button"></button><button class="app-toast-dismiss" type="button" aria-label="Dismiss notification"><span aria-hidden="true">×</span></button></li></template>
    </div>
  </body>
</html>

<script>
  // The people palette (GAP-027), Quick capture (GAP-031), and the
  // notification bell (GAP-053) are React islands that load only for a
  // signed-in member, each on first intent (FER-01): this script carries no
  // React, and every Quick capture opener stays disabled until the shell has
  // a ready session.
  import { startApplicationShell } from "../features/shell/shell-islands/shell-islands.ts";
  import { mountThemeToggle } from "../features/shell/theme-toggle/theme-toggle.ts";
  import { mountThemeSync } from "../lib/theme.ts";
  void startApplicationShell();
  void mountThemeSync();
  void mountThemeToggle();
</script>
