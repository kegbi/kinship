---
import AuthLayout from "../../layouts/AuthLayout.astro";
---

<AuthLayout description="Verify your Kinship email address." pageId="auth.verify-email" title="Verify your email — Kinship">
  <main id="main-content" class="transition-main" tabindex="-1">
    <section class="transition-card" aria-labelledby="verification-heading">
      <p class="eyebrow">Email verification</p>
      <h1 id="verification-heading">Opening your circle…</h1>
      <div id="verification-status" role="status" aria-live="polite" tabindex="-1">
        <p>Checking this single-use link securely.</p>
        <a class="button-link" href="/auth/sign-up" hidden>Return to registration</a>
      </div>
    </section>
  </main>
</AuthLayout>

<script>
  import { mountEmailVerification } from "../../features/auth/verify-email/verify-email.ts";
  void mountEmailVerification();
</script>
