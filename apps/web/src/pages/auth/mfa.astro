---
import AuthLayout from "../../layouts/AuthLayout.astro";
---

<AuthLayout description="Complete your Kinship authentication challenge." pageId="auth.mfa" title="Security check — Kinship">
  <main id="main-content" class="transition-main" tabindex="-1">
    <section class="transition-card" aria-labelledby="mfa-heading">
      <p class="eyebrow">Security check</p>
      <h1 id="mfa-heading">One more step.</h1>
      <p>Enter the six-digit code from your authenticator, or one unused recovery code.</p>
      <form method="post" id="mfa-form" novalidate>
        <label>Authenticator or recovery code<input name="factor" autocomplete="one-time-code" maxlength="128" required /></label>
        <button type="submit" disabled>Continue securely</button>
      </form>
      <div id="auth-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
      <p class="auth-links"><a href="/auth/sign-in">Return to sign-in</a></p>
    </section>
  </main>
</AuthLayout>

<script>
  import { mountMfa } from "../../features/auth/credentials/auth-forms.ts";
  const form = document.querySelector<HTMLFormElement>("#mfa-form");
  if (form) mountMfa(form);
</script>
