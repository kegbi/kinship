---
import AuthLayout from "../../layouts/AuthLayout.astro";
---

<AuthLayout description="Choose a new Kinship password." pageId="auth.reset" title="Reset password — Kinship">
  <main id="main-content" class="transition-main" tabindex="-1">
    <section class="transition-card" aria-labelledby="reset-heading">
      <p class="eyebrow">Password reset</p>
      <h1 id="reset-heading">Choose a new passphrase.</h1>
      <p>Completing this reset revokes every existing browser session.</p>
      <form method="post" id="reset-form" novalidate>
        <label>New password<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" aria-describedby="reset-help" required /></label>
        <p id="reset-help" class="field-help">Use at least 12 characters.</p>
        <button type="submit" disabled>Reset password</button>
      </form>
      <div id="auth-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
      <p class="auth-links"><a href="/auth/forgot-password">Request another link</a></p>
    </section>
  </main>
</AuthLayout>

<script>
  import { mountReset } from "../../features/auth/credentials/auth-forms.ts";
  const form = document.querySelector<HTMLFormElement>("#reset-form");
  if (form) mountReset(form);
</script>
