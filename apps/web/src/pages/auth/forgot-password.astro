---
import AuthLayout from "../../layouts/AuthLayout.astro";
export const prerender = true;
---

<AuthLayout description="Request a private Kinship password reset." pageId="auth.recover" title="Recover access — Kinship">
  <main id="main-content" class="transition-main" tabindex="-1">
    <section class="transition-card" aria-labelledby="recovery-heading">
      <p class="eyebrow">Account recovery</p>
      <h1 id="recovery-heading">Find your way back.</h1>
      <p>Enter your email. The response is intentionally the same whether an account exists or not.</p>
      <form method="post" id="recovery-form" novalidate>
        <label>Email address<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
        <button type="submit">Send recovery link</button>
      </form>
      <div id="auth-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
      <p class="auth-links"><a href="/auth/sign-in">Return to sign-in</a></p>
    </section>
  </main>
</AuthLayout>

<script>
  import { mountRecovery } from "../../features/auth/credentials/auth-forms.ts";
  const form = document.querySelector<HTMLFormElement>("#recovery-form");
  if (form) mountRecovery(form);
</script>
