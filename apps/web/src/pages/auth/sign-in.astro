---
import AuthLayout from "../../layouts/AuthLayout.astro";
export const prerender = true;
---

<AuthLayout description="Sign in to your private Kinship workspace." pageId="auth.sign-in" title="Sign in — Kinship">
  <main id="main-content" class="auth-main" tabindex="-1">
    <section class="auth-intro" aria-labelledby="signin-heading">
      <p class="eyebrow">Welcome back</p>
      <h1 id="signin-heading">Return to your circle.</h1>
      <p>Sign in with your verified Kinship password. If you configured a second factor, we’ll ask for it before creating a session.</p>
    </section>
    <section class="auth-card" aria-label="Sign in">
      <form method="post" id="sign-in-form" novalidate>
        <label>Email address<input name="email" type="email" autocomplete="username" maxlength="254" required /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" maxlength="128" required /></label>
        <button type="submit">Sign in</button>
      </form>
      <div id="auth-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
      <p class="auth-links"><a href="/auth/forgot-password">Forgot your password?</a> <a href="/auth/sign-up">Create a workspace</a></p>
    </section>
  </main>
</AuthLayout>

<script>
  import { mountSignIn } from "../../features/auth/credentials/auth-forms.ts";
  const form = document.querySelector<HTMLFormElement>("#sign-in-form");
  if (form) mountSignIn(form);
</script>
