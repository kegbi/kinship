---
import PublicLayout from "../layouts/PublicLayout.astro";
export const prerender = true;
---

<PublicLayout
  currentPath="/"
  description="A calm, private home for the details that help relationships grow."
  pageId="public.home"
  title="Kinship — Remember what matters"
>
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow">For the people in your life</p>
        <h1 id="hero-heading">
          Relationships deserve a place <em>to grow.</em>
        </h1>
        <p class="lede">
          Remember the small things, follow through on the important ones, and
          stay present with the people who make up your world.
        </p>

        <div class="hero-actions" aria-label="Get started">
          <a class="button-link button-link-primary" href="/auth/sign-up">
            Create account
          </a>
          <a class="button-link" href="/auth/sign-in">Sign in</a>
        </div>

        <div
          class="readiness"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-state="checking"
        >
          <span class="readiness-dot" aria-hidden="true"></span>
          <span class="readiness-copy">
            <strong data-readiness-title>Checking API readiness…</strong>
            <span data-readiness-detail>
              The page remains available while we connect.
            </span>
          </span>
        </div>
      </div>

      <div class="portrait" aria-hidden="true">
        <div class="portrait-orbit portrait-orbit-one"></div>
        <div class="portrait-orbit portrait-orbit-two"></div>
        <div class="portrait-card portrait-card-main">
          <span class="portrait-initials">MK</span>
          <span class="portrait-name">Maya &amp; Kai</span>
          <span class="portrait-note">Dinner · Saturday</span>
        </div>
        <div class="portrait-card portrait-card-small">
          <span class="portrait-heart">♥</span>
          <span>Keep close</span>
        </div>
        <span class="spark spark-one">✦</span>
        <span class="spark spark-two">✦</span>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-heading">
      <div>
        <p class="eyebrow">A quieter kind of software</p>
        <h2 id="principles-heading">Made for care, not engagement.</h2>
      </div>
      <div class="principle-list">
        <article>
          <span aria-hidden="true">01</span>
          <h3>Remember naturally</h3>
          <p>
            Keep context together, from important dates to the last
            conversation.
          </p>
        </article>
        <article>
          <span aria-hidden="true">02</span>
          <h3>Act with intention</h3>
          <p>Turn thoughtful intentions into timely, human follow-through.</p>
        </article>
        <article>
          <span aria-hidden="true">03</span>
          <h3>Stay in control</h3>
          <p>Your private relationship data stays organized around you.</p>
        </article>
      </div>
    </section>
  </main>

  <script>
    import { checkApiReadiness } from "../lib/health-status.ts";

    const status = document.querySelector<HTMLElement>("[role='status']");
    const title = document.querySelector<HTMLElement>("[data-readiness-title]");
    const detail = document.querySelector<HTMLElement>("[data-readiness-detail]");

    if (status && title && detail) {
      const state = await checkApiReadiness();
      status.dataset.state = state.kind;
      title.textContent = state.message;
      detail.textContent = state.kind === "ready"
        ? "The service is healthy and ready for requests."
        : "You can still explore this page. Try again when the service returns.";
    }
  </script>
</PublicLayout>
