---
import AuthLayout from "../layouts/AuthLayout.astro";
export const prerender = true;
---

<AuthLayout description="Enter your protected Kinship workspace." pageId="app.today" title="Your workspace — Kinship">
  <main id="main-content" class="transition-main" tabindex="-1">
    <section class="transition-card" aria-labelledby="entry-heading">
      <p class="eyebrow">First workspace</p>
      <h1 id="entry-heading">Preparing your workspace…</h1>
      <div id="entry-status" role="status" aria-live="polite" tabindex="-1"><p>Resolving your protected session and active workspace.</p></div>
    </section>
  </main>
</AuthLayout>

<script>
  import { mountProtectedEntry } from "../lib/auth-forms.ts";
  void mountProtectedEntry();
</script>
