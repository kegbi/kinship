---
import LegalDocument from "../components/LegalDocument.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { readPublicLegalPage } from "../lib/legal.ts";
// ADR 0007: the active policy is request-time public data, so this page
// renders on demand; the gateway keeps a successful page for five minutes.
export const prerender = false;
const legal = await readPublicLegalPage("privacy", {
  apiOrigin: process.env.API_ORIGIN ?? "http://127.0.0.1:8000",
  requestId: Astro.request.headers.get("x-request-id"),
});
Astro.response.status = legal.status;
---

<PublicLayout currentPath="/privacy" description="Review the current Kinship privacy policy." pageId="legal.privacy" title="Privacy policy — Kinship">
  <LegalDocument legal={legal} />
</PublicLayout>
