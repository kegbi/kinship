---
import PublicLayout from "../layouts/PublicLayout.astro";
export const prerender = true;
---

<PublicLayout currentPath="/privacy" description="Review the current Kinship privacy policy." pageId="legal.privacy" title="Privacy policy — Kinship">
  <main id="main-content" class="legal-page" tabindex="-1">
    <p data-legal-state role="status" aria-live="polite">Loading privacy policy…</p>
    <h1 data-legal-title>Privacy policy</h1>
    <p data-legal-version></p>
    <article data-legal-content class="legal-document"></article>
  </main>
</PublicLayout>

<script>
  import { mountPublicLegal } from "../lib/legal.ts";
  void mountPublicLegal("privacy");
</script>
