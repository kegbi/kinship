---
/**
 * The canonical person workspace, `/app/people/:personId`, as one static
 * shell the gateway serves for every person. It renders from the section
 * registry (GAP-028): the hero, the section directory, the profile facts
 * rail, and the four stream zones, each section through its partial under
 * `components/person/`. `lib/people-profile.ts` resolves the person and
 * activates each section's owner.
 */
import ApplicationLayout from "../../layouts/ApplicationLayout.astro";
import AuditSummarySection from "../../components/person/AuditSummarySection.astro";
import CommunicationSection from "../../components/person/CommunicationSection.astro";
import FilesSection from "../../components/person/FilesSection.astro";
import GiftsSection from "../../components/person/GiftsSection.astro";
import ImportantDatesSection from "../../components/person/ImportantDatesSection.astro";
import InteractionSection from "../../components/person/InteractionSection.astro";
import LifeEventsSection from "../../components/person/LifeEventsSection.astro";
import PersonHero from "../../components/person/PersonHero.astro";
import PersonSection from "../../components/person/PersonSection.astro";
import PersonTimeline from "../../components/person/PersonTimeline.astro";
import ProfileFactSection from "../../components/person/ProfileFactSection.astro";
import RelationshipsSection from "../../components/person/RelationshipsSection.astro";
import RemindersSection from "../../components/person/RemindersSection.astro";
import StayInTouchSection from "../../components/person/StayInTouchSection.astro";
import TasksSection from "../../components/person/TasksSection.astro";
import {
  PERSON_SECTIONS,
  type PersonSectionId,
  railSections,
  STREAM_ZONES,
  zoneSections,
} from "../../features/person/sections.ts";
import { buttonVariants, segmentVariants } from "../../components/ui/variants.ts";

export const prerender = true;

const segment = segmentVariants();

/** Each section's partial; the identity editor renders inside the hero. */
const partials: Readonly<Partial<Record<PersonSectionId, typeof PersonSection>>> = {
  "important-dates": ImportantDatesSection,
  "contact-methods": ProfileFactSection,
  addresses: ProfileFactSection,
  relationships: RelationshipsSection,
  "first-meeting": ProfileFactSection,
  work: ProfileFactSection,
  "food-preferences": ProfileFactSection,
  pets: ProfileFactSection,
  "life-events": LifeEventsSection,
  notes: InteractionSection,
  conversations: CommunicationSection,
  calls: CommunicationSection,
  activities: InteractionSection,
  tasks: TasksSection,
  reminders: RemindersSection,
  "stay-in-touch": StayInTouchSection,
  gifts: GiftsSection,
  debts: GiftsSection,
  documents: FilesSection,
  photos: FilesSection,
  "audit-summary": AuditSummarySection,
};
const partial = (id: PersonSectionId) => partials[id] ?? PersonSection;
const zones = STREAM_ZONES.map((zone) => ({ ...zone, sections: zoneSections(zone.id) }));
---

<ApplicationLayout
  current="people"
  description="Open one canonical workspace for a saved person in Kinship."
  pageId="people.profile"
  title="Person — Kinship"
>
  <main id="main-content" class="page-frame people-profile-page" tabindex="-1">
    <section id="person-profile-state" class="person-profile-state" role="status" aria-live="polite" tabindex="-1" hidden></section>

    <section id="person-profile-ready" class="person-workspace" aria-labelledby="person-profile-name" aria-busy="true">
      <PersonHero />

      <div class="person-workspace-navigation">
          <details class="profile-section-directory">
            <summary>Workspace sections</summary>
            <nav id="person-profile-sections" aria-label="Person workspace sections">
              <ul>
                {PERSON_SECTIONS.map((section) => (
                  <li><a href={`?section=${section.id}`} data-section-link={section.id}>{section.title}</a></li>
                ))}
              </ul>
            </nav>
          </details>
          <div class="zone-switcher">
            <div class="zone-mini-identity" data-zone-mini-identity aria-hidden="true" hidden>
              <span class="zone-mini-avatar" data-zone-mini-avatar></span>
              <span class="zone-mini-name" data-zone-mini-name></span>
            </div>
            <div class="zone-filter" role="group" aria-label="Filter person sections">
              <button class={segment} data-zone-filter="all" type="button" aria-pressed="true">All</button>
              {STREAM_ZONES.map((zone) => (
                <button class={segment} data-zone-filter={zone.id} type="button" aria-pressed="false">{zone.title}</button>
              ))}
            </div>
          </div>
      </div>
      <p id="person-profile-section-notice" class="profile-section-notice" role="status" aria-live="polite" tabindex="-1" hidden></p>

      <div class="person-workspace-layout">
        <section class="profile-facts-column" aria-labelledby="profile-facts-heading">
          <header class="profile-facts-heading">
            <h2 id="profile-facts-heading">Profile facts</h2>
            <p>The people, places, and details that matter.</p>
          </header>
          <div class="profile-facts-rail" aria-busy="true">
            {railSections().map((section) => {
              const Section = partial(section.id);
              return <Section section={section} />;
            })}
          </div>
        </section>

        <div class="profile-section-list">
          <section id="person-first-run" class="person-first-run" aria-labelledby="person-first-run-heading" hidden>
            <h2 id="person-first-run-heading">Start this person's story</h2>
            <p>Nothing is recorded for this person yet. These three make everything else useful.</p>
            <div class="person-first-run-actions" role="group" aria-label="First actions">
              <button class={buttonVariants()} data-first-run-action="first-meeting" type="button">Log how you met</button>
              <button class={buttonVariants({ variant: "outline" })} data-first-run-action="important-dates" type="button">Add a birthday</button>
              <button class={buttonVariants({ variant: "outline" })} data-first-run-action="stay-in-touch" type="button">Set a stay-in-touch cadence</button>
            </div>
            <button class={buttonVariants({ variant: "outline" })} data-first-run-dismiss type="button">Show all sections</button>
          </section>
          {zones.map((zone) => (
            <section class="person-zone" data-zone={zone.id} aria-labelledby={`person-zone-${zone.id}-heading`} aria-busy="true">
              <h2 id={`person-zone-${zone.id}-heading`}>{zone.title}</h2>
              {zone.id === "timeline" && <PersonTimeline />}
              {zone.sections.map((section) => {
                const Section = partial(section.id);
                return <Section section={section} />;
              })}
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
</ApplicationLayout>

<script>
  import { mountPeopleProfile } from "../../lib/people-profile.ts";
  void mountPeopleProfile();
</script>
