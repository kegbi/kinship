---
import ApplicationLayout from "../../layouts/ApplicationLayout.astro";
export const prerender = true;
---

<ApplicationLayout
  current="people"
  description="View a saved person identity in the active Kinship workspace."
  pageId="people.profile"
  title="Person — Kinship"
>
  <main id="main-content" class="page-frame people-profile-page" tabindex="-1">
    <section id="person-profile-state" class="person-profile-state" role="status" aria-live="polite" tabindex="-1">
      <p class="eyebrow">Person workspace</p>
      <h1>Opening person…</h1>
      <p>Loading the saved identity from your active workspace.</p>
    </section>

    <section id="person-profile-ready" class="created-person" aria-labelledby="person-profile-name" hidden>
      <p class="eyebrow">Person workspace · <span data-workspace-name></span></p>
      <h1 id="person-profile-name" tabindex="-1"><span class="sr-only">Saved person identity</span></h1>
      <p class="state-badge calm">Identity saved</p>
      <p id="person-profile-partial" class="state-badge" hidden>Partial identity · unknown values preserved</p>
      <dl class="identity-summary">
        <div><dt>Given name</dt><dd data-profile-field="givenName"></dd></div>
        <div><dt>Middle name</dt><dd data-profile-field="middleName"></dd></div>
        <div><dt>Family name</dt><dd data-profile-field="familyName"></dd></div>
        <div><dt>Nickname</dt><dd data-profile-field="nickname"></dd></div>
      </dl>
      <aside class="profile-next-step">
        <h2>Profile foundation</h2>
        <p>This canonical page currently shows the saved identity. Additional profile sections are not available yet.</p>
      </aside>
      <a class="button-link" href="/app/people/new">Add another person</a>
    </section>
  </main>
</ApplicationLayout>

<script>
  import { mountPeopleProfile } from "../../lib/people-profile.ts";
  void mountPeopleProfile();
</script>
