---
import ApplicationLayout from "../../layouts/ApplicationLayout.astro";
import SectionIcon, { type SectionIconName } from "../../components/SectionIcon.astro";

export const prerender = true;

const sections = [
  ["identity-summary", "Identity summary"],
  ["important-dates", "Important dates"],
  ["contact-methods", "Contact methods"],
  ["addresses", "Addresses"],
  ["relationships", "Relationships"],
  ["first-meeting", "First meeting"],
  ["work", "Work"],
  ["food-preferences", "Food preferences"],
  ["pets", "Pets"],
  ["life-events", "Life events"],
  ["notes", "Notes"],
  ["conversations", "Conversations"],
  ["calls", "Calls"],
  ["activities", "Activities"],
  ["tasks", "Tasks"],
  ["reminders", "Reminders"],
  ["stay-in-touch", "Stay in touch"],
  ["gifts", "Gifts"],
  ["debts", "Debts"],
  ["documents", "Documents"],
  ["photos", "Photos"],
  ["audit-summary", "Audit summary"],
] as const;
const streamZones = [
  ["timeline", "Timeline", ["life-events", "notes", "conversations", "calls", "activities"]],
  ["planning", "Planning", ["tasks", "reminders"]],
  ["things", "Things", ["gifts", "debts", "documents", "photos"]],
  ["admin", "Admin", ["audit-summary"]],
] as const;
const sectionIcons = {
  "important-dates": "important-dates",
  "contact-methods": "contact-methods",
  addresses: "addresses",
  relationships: "relationships",
  "first-meeting": "first-meeting",
  work: "work",
  "food-preferences": "food-preferences",
  pets: "pets",
  "life-events": "life-events",
  notes: "notes",
  conversations: "conversations",
  calls: "calls",
  activities: "activities",
  tasks: "tasks",
  reminders: "reminders",
  "stay-in-touch": "stay-in-touch",
  gifts: "gifts",
  debts: "debts",
  documents: "documents",
  photos: "photos",
  "audit-summary": "audit",
} as const satisfies Partial<Record<string, SectionIconName>>;
const railSections = [
  ["contact-methods", "Contact methods"],
  ["relationships", "Relationships"],
  ["important-dates", "Important dates"],
  ["addresses", "Addresses"],
  ["work", "Work"],
  ["pets", "Pets"],
  ["food-preferences", "Food preferences"],
  ["first-meeting", "First meeting"],
  ["stay-in-touch", "Stay in touch"],
] as const;
---

<ApplicationLayout
  current="people"
  description="Open one canonical workspace for a saved person in Kinship."
  pageId="people.profile"
  title="Person — Kinship"
>
  <main id="main-content" class="page-frame people-profile-page" tabindex="-1">
    <section id="person-profile-state" class="person-profile-state" role="status" aria-live="polite" tabindex="-1" hidden></section>

    <section id="person-profile-ready" class="person-workspace" aria-labelledby="person-profile-name" aria-busy="true">
      <header class="person-profile-hero">
        <nav class="person-profile-breadcrumb" aria-label="Breadcrumb">
          <a href="/app/people">People</a>
          <span aria-hidden="true">/</span>
          <span data-person-breadcrumb-name aria-current="page"><span class="skeleton skeleton-chip" aria-hidden="true"></span><span class="sr-only">Loading person…</span></span>
        </nav>

        <div id="person-profile-avatar" class="person-profile-avatar" aria-hidden="true"><span class="skeleton skeleton-avatar" aria-hidden="true"></span></div>
        <div class="person-profile-heading">
          <div class="person-profile-title">
            <h1 id="person-profile-name" tabindex="-1"><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span><span class="sr-only">Loading person…</span></h1>
            <p id="person-profile-nickname" hidden></p>
          </div>
          <div class="person-profile-badges" role="group" aria-label="Person states">
            <p id="person-profile-saved-state" class="state-badge calm"><span class="skeleton skeleton-chip" aria-hidden="true"></span><span class="sr-only">Loading person state…</span></p>
            <p id="person-profile-favorite" class="state-badge favorite" hidden>Favorite</p>
            <p id="person-profile-self" class="state-badge calm" hidden>Your person record</p>
            <p id="person-profile-deceased" class="state-badge" hidden>Deceased</p>
            <p id="person-profile-archived" class="state-badge archived" hidden>Archived person · read-only</p>
            <p id="person-profile-partial" class="state-badge" hidden>Partial identity · unknown values preserved</p>
          </div>
          <p class="person-profile-description" data-profile-description><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span></span><span class="sr-only">Loading person description…</span></p>
        </div>

        <div class="person-profile-actions" data-person-profile-actions role="group" aria-label="Person actions">
          <button
            class="button-primary"
            data-person-interaction-capture
            data-quick-capture
            data-interaction-intended-kind="activity"
            type="button"
          >Log interaction</button>
          <button
            class="button-secondary"
            data-person-interaction-capture
            data-quick-capture
            data-interaction-intended-kind="note"
            type="button"
          >Add note</button>
          <div class="person-menu" role="group" aria-label="Person menu">
            <button
              id="person-menu-toggle"
              class="button-secondary"
              type="button"
              aria-label="Open person menu"
              aria-expanded="false"
              aria-controls="person-menu"
            ><span aria-hidden="true">…</span></button>
            <div id="person-menu" class="person-menu-popover" hidden>
              <button id="person-edit-open" class="button-secondary" type="button">Edit person</button>
              <a id="person-export-vcard" class="button-secondary" href="/app/people" download hidden>Export vCard</a>
              <button id="person-archive" class="button-secondary" type="button">Archive person</button>
              <button id="person-audit-history" class="button-secondary" type="button">Audit history</button>
              <button id="person-delete-open" class="button-danger" type="button">Delete person</button>
            </div>
          </div>
        </div>

        <dl class="person-vital-stats" data-person-vital-stats>
          <div>
            <dt>Age or birthday</dt>
            <dd><a href="?section=important-dates" data-person-vital-value="birthday"><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="sr-only">Loading birthday…</span></a></dd>
          </div>
          <div>
            <dt>Last contact</dt>
            <dd><a href="?section=activities" data-profile-last-contact><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="sr-only">Loading last contact…</span></a></dd>
          </div>
          <div>
            <dt>Next reminder</dt>
            <dd><a href="?section=reminders" data-person-vital-value="next-reminder"><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="sr-only">Loading next reminder…</span></a></dd>
          </div>
          <div>
            <dt>Stay in touch</dt>
            <dd><a href="?section=stay-in-touch"><span id="person-profile-due-state" role="status"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="sr-only">Loading due information…</span></span></a></dd>
          </div>
          <div>
            <dt>Work</dt>
            <dd><a href="?section=work" data-person-vital-value="work"><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span><span class="sr-only">Loading work…</span></a></dd>
          </div>
          <div>
            <dt>First met</dt>
            <dd><a href="?section=first-meeting" data-person-vital-value="first-meeting"><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="sr-only">Loading first meeting…</span></a></dd>
          </div>
        </dl>

        <div class="person-hero-tags" data-profile-fact-section="tags" data-section-state="loading" aria-busy="true">
          <ul id="person-profile-tags" class="profile-tag-list" aria-label="Person tags"></ul>
          <p data-profile-fact-state class="section-state"><span class="sr-only">Loading tag assignments…</span><span class="skeleton skeleton-chip" aria-hidden="true"></span></p>
          <button data-profile-fact-add class="button-secondary" type="button" hidden>Edit tags</button>
          <form data-profile-fact-form class="profile-fact-form" hidden novalidate></form>
        </div>

        <p id="person-lifecycle-status" class="section-state person-lifecycle-status" role="status" aria-live="polite"></p>

        <form
          id="person-edit-form"
          class="person-lifecycle-form"
          data-profile-section="identity-summary"
          data-section-state="ready"
          aria-label="Edit person"
          hidden
        >
          <dl class="identity-edit-context" hidden>
            <div><dt>Given name</dt><dd data-profile-field="givenName"></dd></div>
            <div><dt>Middle name</dt><dd data-profile-field="middleName"></dd></div>
            <div><dt>Family name</dt><dd data-profile-field="familyName"></dd></div>
            <div><dt>Nickname</dt><dd data-profile-field="nickname"></dd></div>
            <div><dt>Gender</dt><dd data-profile-field="gender"></dd></div>
          </dl>
          <div class="form-grid">
            <label>Given name <input name="givenName" maxlength="200" /></label>
            <label>Middle name <input name="middleName" maxlength="200" /></label>
            <label>Family name <input name="familyName" maxlength="200" /></label>
            <label>Nickname <input name="nickname" maxlength="200" /></label>
          </div>
          <label class="checkbox-row"><input name="isPartial" type="checkbox" /> This is a partial identity</label>
          <div class="person-lifecycle-buttons">
            <button class="button-primary" type="submit">Save person</button>
            <button id="person-edit-cancel" class="button-secondary" type="button">Cancel edit</button>
          </div>
        </form>

        <dialog id="person-delete-dialog" class="person-delete-dialog" aria-labelledby="person-delete-heading" aria-describedby="person-delete-impact">
          <form id="person-delete-form">
            <h3 id="person-delete-heading">Delete this person?</h3>
            <p id="person-delete-impact" role="status">Loading deletion impact…</p>
            <label>Confirmation <input id="person-delete-confirmation" name="confirmation" autocomplete="off" required /></label>
            <div class="person-lifecycle-buttons">
              <button class="button-danger" type="submit">Confirm delete</button>
              <button id="person-delete-cancel" class="button-secondary" type="button">Cancel delete</button>
            </div>
          </form>
        </dialog>
      </header>

      <aside class="person-archived-banner" data-person-archived-banner hidden>
        <p><strong>This person is archived.</strong> Editing is disabled.</p>
        <button id="person-restore" class="button-secondary" type="button">Restore person</button>
      </aside>

      <div class="person-workspace-navigation">
          <details class="profile-section-directory">
            <summary>Workspace sections</summary>
            <nav id="person-profile-sections" aria-label="Person workspace sections">
              <ul>
                {sections.map(([id, title]) => (
                  <li><a href={`?section=${id}`} data-section-link={id}>{title}</a></li>
                ))}
              </ul>
            </nav>
          </details>
          <div class="zone-switcher">
            <div class="zone-mini-identity" data-zone-mini-identity aria-hidden="true" hidden>
              <span class="zone-mini-avatar" data-zone-mini-avatar></span>
              <span class="zone-mini-name" data-zone-mini-name></span>
            </div>
            <div class="zone-filter" role="group" aria-label="Filter person sections">
              <button class="button-primary" data-zone-filter="all" type="button" aria-pressed="true">All</button>
              <button class="button-secondary" data-zone-filter="timeline" type="button" aria-pressed="false">Timeline</button>
              <button class="button-secondary" data-zone-filter="planning" type="button" aria-pressed="false">Planning</button>
              <button class="button-secondary" data-zone-filter="things" type="button" aria-pressed="false">Things</button>
              <button class="button-secondary" data-zone-filter="admin" type="button" aria-pressed="false">Admin</button>
            </div>
          </div>
      </div>
      <p id="person-profile-section-notice" class="profile-section-notice" role="status" aria-live="polite" tabindex="-1" hidden></p>

      <div class="person-workspace-layout">
        <section class="profile-facts-column" aria-labelledby="profile-facts-heading">
          <header class="profile-facts-heading">
            <h2 id="profile-facts-heading">Profile facts</h2>
            <p>The people, places, and details that matter.</p>
          </header>
          <div class="profile-facts-rail" aria-busy="true">
            {railSections.map(([id, title]) => id === "important-dates"
              ? (
                <section
                  id="profile-section-important-dates"
                  class="profile-section-card profile-rail-block"
                  data-profile-section="important-dates"
                  data-section-state="loading"
                  tabindex="-1"
                  aria-labelledby="profile-section-important-dates-heading"
                >
                  <header class="profile-section-heading">
                    <SectionIcon name="important-dates" class="profile-rail-icon" />
                    <h3 id="profile-section-important-dates-heading">Important dates</h3>
                    <span class="profile-rail-count" data-profile-rail-count hidden></span>
                    <button id="important-date-add" class="button-primary profile-rail-add" type="button" aria-label="Add important date" hidden><span aria-hidden="true">+</span></button>
                  </header>
                  <p id="important-dates-state" class="section-state" tabindex="-1"><span class="sr-only">Loading important dates…</span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span></p>
                  <ul id="important-dates-list" class="important-dates-list" aria-label="Saved important dates"></ul>
                  <form id="important-date-form" class="important-date-form" hidden novalidate>
                    <input id="important-date-version" name="expectedUpdatedAt" type="hidden" />
                    <div class="form-grid">
                      <label>
                        Date type
                        <select id="important-date-kind" name="kind">
                          <option value="birthday">Birthday</option>
                          <option value="first_met">First meeting</option>
                          <option value="deceased">Date of death</option>
                          <option value="custom">Custom</option>
                        </select>
                      </label>
                      <label id="important-date-label-row" hidden>
                        Custom label
                        <input id="important-date-label" name="label" maxlength="200" />
                      </label>
                      <label>
                        Known components
                        <select id="important-date-precision" name="precision">
                          <option value="full">Year, month, and day</option>
                          <option value="year_month">Year and month</option>
                          <option value="month_day">Month and day; year unknown</option>
                          <option value="year">Year only</option>
                          <option value="month">Month only</option>
                          <option value="day">Day only</option>
                          <option value="unknown">Date unknown</option>
                        </select>
                      </label>
                      <label data-date-component="year">
                        Year
                        <input id="important-date-year" name="year" type="number" min="1" max="9999" inputmode="numeric" />
                      </label>
                      <label data-date-component="month">
                        Month
                        <select id="important-date-month" name="month">
                          <option value="">Select month</option>
                          {Array.from({ length: 12 }, (_, index) => <option value={index + 1}>{index + 1}</option>)}
                        </select>
                      </label>
                      <label data-date-component="day">
                        Day
                        <input id="important-date-day" name="day" type="number" min="1" max="31" inputmode="numeric" />
                      </label>
                    </div>
                    <label id="important-date-approximate-row" class="checkbox-row">
                      <input id="important-date-approximate" name="isYearApproximate" type="checkbox" />
                      The stated year is approximate
                    </label>
                    <label class="checkbox-row">
                      <input id="important-date-age" name="isAgeBased" type="checkbox" />
                      Show age when the year is known
                    </label>
                    <label>
                      Notes (optional)
                      <textarea id="important-date-notes" name="notes" maxlength="2000" rows="3"></textarea>
                    </label>
                    <p class="form-hint">Annual reminders are scheduled only when both month and day are known. Missing components are never invented.</p>
                    <p id="important-date-form-state" class="section-state" role="alert" tabindex="-1"></p>
                    <div class="form-actions">
                      <button type="submit" class="button-primary">Save date</button>
                      <button id="important-date-cancel" class="button-secondary" type="button">Cancel</button>
                    </div>
                  </form>
                </section>
              )
              : id === "relationships"
              ? (
                <section
                  id="profile-section-relationships"
                  class="profile-section-card profile-rail-block"
                  data-profile-section="relationships"
                  data-section-state="loading"
                  tabindex="-1"
                  aria-labelledby="profile-section-relationships-heading"
                >
                  <header class="profile-section-heading">
                    <SectionIcon name="relationships" class="profile-rail-icon" />
                    <h3 id="profile-section-relationships-heading">Relationships</h3>
                    <span class="profile-rail-count" data-profile-rail-count hidden></span>
                    <button id="relationship-add" class="button-primary profile-rail-add" type="button" aria-label="Add relationship" hidden><span aria-hidden="true">+</span></button>
                  </header>
                  <p id="relationships-state" data-rail-editor-feedback class="section-state" tabindex="-1"><span class="sr-only">Loading relationships…</span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span></p>
                  <ul id="relationships-list" class="profile-fact-list" aria-label="Saved relationships" tabindex="-1"></ul>
                  <nav class="form-actions" aria-label="Relationship pages">
                    <button id="relationships-previous" class="button-secondary" type="button" hidden>Previous relationships</button>
                    <button id="relationships-load-more" class="button-secondary" type="button" hidden>Next relationships</button>
                  </nav>
                  <form id="relationship-form" class="profile-fact-form" hidden novalidate>
                    <fieldset>
                      <legend>Choose an existing person</legend>
                      <label>Search people <input id="relationship-person-search" type="search" maxlength="200" /></label>
                      <button id="relationship-person-search-button" class="button-secondary" type="button">Search people</button>
                      <label>Related person <select id="relationship-target" name="targetPersonId"><option value="">Select existing person</option></select></label>
                    </fieldset>
                    <fieldset>
                      <legend>Or create a new related person</legend>
                      <div class="form-grid">
                        <label>New person given name <input name="newGivenName" maxlength="200" /></label>
                        <label>New person family name <input name="newFamilyName" maxlength="200" /></label>
                      </div>
                    </fieldset>
                    <fieldset>
                      <legend>Relationship type</legend>
                      <label>Search relationship types <input id="relationship-type-search" type="search" maxlength="200" /></label>
                      <button id="relationship-type-search-button" class="button-secondary" type="button">Search relationship types</button>
                      <label>Relationship type <select id="relationship-type" name="relationshipTypeId" required><option value="">Select relationship type</option></select></label>
                      <nav class="form-actions" aria-label="Relationship type pages">
                        <button id="relationship-types-previous" class="button-secondary" type="button" hidden>Previous relationship types</button>
                        <button id="relationship-types-next" class="button-secondary" type="button" hidden>Next relationship types</button>
                      </nav>
                    </fieldset>
                    <div id="relationship-duplicate-choices" role="group" aria-label="Possible duplicate person choices" hidden>
                      <p>A person with this name may already exist.</p>
                      <button id="relationship-select-existing" class="button-secondary" type="button">Select existing person</button>
                      <button id="relationship-create-anyway" class="button-secondary" type="button">Create anyway</button>
                    </div>
                    <div class="form-actions">
                      <button class="button-primary" type="submit">Save relationship</button>
                      <button id="relationship-cancel" class="button-secondary" type="button">Cancel</button>
                    </div>
                  </form>
                </section>
              )
              : id === "stay-in-touch"
              ? (
                <section
                  id="profile-section-stay-in-touch"
                  class="profile-section-card profile-rail-block"
                  data-profile-section="stay-in-touch"
                  data-section-state="loading"
                  tabindex="-1"
                  aria-labelledby="profile-section-stay-in-touch-heading"
                >
                  <header class="profile-section-heading">
                    <SectionIcon name="stay-in-touch" class="profile-rail-icon" />
                    <h3 id="profile-section-stay-in-touch-heading">Stay in touch</h3>
                    <span class="profile-rail-count" data-profile-rail-count hidden></span>
                    <button data-cadence-add class="button-primary profile-rail-add" type="button" aria-label="Add stay-in-touch cadence" hidden><span aria-hidden="true">+</span></button>
                  </header>
                  <p data-cadence-state data-rail-editor-feedback class="section-state" tabindex="-1"><span class="sr-only">Loading stay-in-touch cadence…</span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span></p>
                  <ul data-cadence-list class="task-list" aria-label="Stay-in-touch cadence"></ul>
                  <form data-cadence-form class="profile-fact-form" hidden novalidate>
                    <label>Reconnect every <input name="intervalCount" type="number" min="1" max="100" value="1" required /></label>
                    <label>Calendar unit
                      <select name="intervalUnit">
                        <option value="week">Week</option>
                        <option value="month">Month</option>
                        <option value="year">Year</option>
                        <option value="day">Day</option>
                      </select>
                    </label>
                    <div class="form-actions"><button class="button-primary" type="submit">Save cadence</button><button data-cadence-cancel class="button-secondary" type="button">Cancel</button></div>
                  </form>
                </section>
              )
              : (
                <section
                  id={`profile-section-${id}`}
                  class="profile-section-card profile-rail-block"
                  data-profile-section={id}
                  data-profile-fact-section={id}
                  data-section-state="loading"
                  tabindex="-1"
                  aria-labelledby={`profile-section-${id}-heading`}
                >
                  <header class="profile-section-heading">
                    <SectionIcon name={sectionIcons[id]} class="profile-rail-icon" />
                    <h3 id={`profile-section-${id}-heading`}>{title}</h3>
                    <span class="profile-rail-count" data-profile-rail-count hidden></span>
                    <button
                      data-profile-fact-add
                      data-profile-fact-add-icon
                      class="button-primary profile-rail-add"
                      type="button"
                      aria-label={`Add ${title.toLowerCase()}`}
                      hidden
                    ><span aria-hidden="true">+</span></button>
                  </header>
                  <p data-profile-fact-state class="section-state" tabindex="-1"><span class="sr-only">Loading {title.toLowerCase()}…</span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span></p>
                  <ul data-profile-fact-list class="profile-fact-list" aria-label={`Saved ${title.toLowerCase()}`}></ul>
                  <form data-profile-fact-form class="profile-fact-form" hidden novalidate></form>
                </section>
              ))}
          </div>
        </section>

        <div class="profile-section-list">
          <section id="person-first-run" class="person-first-run" aria-labelledby="person-first-run-heading" hidden>
            <h2 id="person-first-run-heading">Start this person's story</h2>
            <p>Nothing is recorded for this person yet. These three make everything else useful.</p>
            <div class="person-first-run-actions" role="group" aria-label="First actions">
              <button class="button-primary" data-first-run-action="first-meeting" type="button">Log how you met</button>
              <button class="button-secondary" data-first-run-action="important-dates" type="button">Add a birthday</button>
              <button class="button-secondary" data-first-run-action="stay-in-touch" type="button">Set a stay-in-touch cadence</button>
            </div>
            <button class="button-secondary" data-first-run-dismiss type="button">Show all sections</button>
          </section>
          {streamZones.map(([zone, zoneTitle, zoneSectionIds]) => (
            <section class="person-zone" data-zone={zone} aria-labelledby={`person-zone-${zone}-heading`} aria-busy="true">
              <h2 id={`person-zone-${zone}-heading`}>{zoneTitle}</h2>
              {zone === "timeline"
                ? (
                  <section id="person-timeline" class="profile-section-card person-timeline" aria-labelledby="person-timeline-heading">
                    <header class="profile-section-heading">
                      <SectionIcon name="timeline" class="profile-section-glyph" />
                      <div class="profile-section-title"><h3 id="person-timeline-heading">Everything, in order</h3></div>
                    </header>
                    <div class="person-timeline-filters" role="group" aria-label="Filter timeline by type">
                      <button class="button-primary" data-timeline-filter="all" type="button" aria-pressed="true" disabled>All types</button>
                      <button class="button-secondary" data-timeline-filter="note" type="button" aria-pressed="false" disabled>Notes</button>
                      <button class="button-secondary" data-timeline-filter="call" type="button" aria-pressed="false" disabled>Calls</button>
                      <button class="button-secondary" data-timeline-filter="conversation" type="button" aria-pressed="false" disabled>Conversations</button>
                      <button class="button-secondary" data-timeline-filter="activity" type="button" aria-pressed="false" disabled>Activities</button>
                      <button class="button-secondary" data-timeline-filter="life-event" type="button" aria-pressed="false" disabled>Life events</button>
                    </div>
                    <p data-timeline-state class="section-state"><span class="sr-only">Loading the timeline…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                    <ul data-timeline-list class="person-timeline-list" aria-label="Person timeline"></ul>
                    <button data-timeline-more class="button-secondary" type="button" hidden>Load older events</button>
                    <button data-timeline-retry class="button-secondary" type="button" hidden>Retry the timeline</button>
                  </section>
                )
                : null}
              {sections.filter(([id]) => zoneSectionIds.some((sectionId) => sectionId === id)).map(([id, title]) => id === "calls" || id === "conversations"
            ? (
              <section
                id={`profile-section-${id}`}
                class="profile-section-card communication-section-card"
                data-profile-section={id}
                data-communication-kind={id === "calls" ? "call" : "conversation"}
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby={`profile-section-${id}-heading`}
              >
                <header class="profile-section-heading">
                  <SectionIcon name={sectionIcons[id]} class="profile-section-glyph" />
                  <div class="profile-section-title">
                    <h3 id={`profile-section-${id}-heading`}>{title}</h3>
                    <span data-communication-badge class="state-badge">Loading</span>
                  </div>
                  <button data-communication-add class="button-primary profile-section-cta" type="button" hidden>{id === "calls" ? "Log call" : "Log conversation"}</button>
                </header>
                <p data-communication-state class="section-state"><span class="sr-only">Loading {title.toLowerCase()}…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <button data-communication-load-retry class="button-secondary" type="button" hidden>Retry loading communications</button>
                <ul data-communication-list class="interaction-list" aria-label={`Recent ${title.toLowerCase()}`} hidden></ul>
                <form data-communication-form class="profile-fact-form" hidden novalidate>
                  <label>When it happened <input name="happenedAt" type="datetime-local" required /></label>
                  {id === "calls"
                    ? (
                      <>
                        <label>Call direction <select name="callDirection" required><option value="contact">They called me</option><option value="member">I called them</option></select></label>
                        <label>Details (optional) <textarea name="content" maxlength="10000"></textarea></label>
                        <label>Emotions (optional) <select name="emotionIds" multiple></select></label>
                      </>
                    )
                    : (
                      <>
                        <label>Channel <select name="channelTypeId" required><option value="">Select channel</option></select></label>
                        <label>Specific contact method (optional) <select name="contactMethodId"><option value="">No specific method</option></select></label>
                        <label>Title (optional) <input name="title" maxlength="500" /></label>
                        <div data-message-rows></div>
                        <button data-add-message class="button-secondary" type="button">Add message</button>
                      </>
                    )}
                  <p data-communication-form-state class="section-state" role="alert" tabindex="-1"></p>
                  <div class="form-actions"><button class="button-primary" type="submit">Save {id === "calls" ? "call" : "conversation"}</button><button data-communication-cancel class="button-secondary" type="button">Cancel</button><button data-communication-refresh class="button-secondary" type="button" hidden>Retry refresh</button></div>
                </form>
              </section>
            )
            : id === "activities" || id === "notes"
            ? (
              <section
                id={`profile-section-${id}`}
                class="profile-section-card interaction-section-card"
                data-profile-section={id}
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby={`profile-section-${id}-heading`}
              >
                <header class="profile-section-heading">
                  <SectionIcon name={sectionIcons[id]} class="profile-section-glyph" />
                  <div class="profile-section-title">
                    <h3 id={`profile-section-${id}-heading`}>{title}</h3>
                  </div>
                  <button
                    class="button-primary profile-section-cta"
                    data-person-interaction-capture
                    data-quick-capture
                    data-interaction-intended-kind={id === "activities" ? "activity" : "note"}
                    type="button"
                  >{id === "activities" ? "Log activity" : "Add note"}</button>
                </header>
                <p
                  id={id === "activities" ? "person-activities-state" : "person-notes-state"}
                  class="section-state"
                ><span class="sr-only">Loading {title.toLowerCase()}…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <ul
                  id={id === "activities" ? "person-activities-list" : "person-notes-list"}
                  class="interaction-list"
                  aria-label={`Recent ${title.toLowerCase()}`}
                  hidden
                ></ul>
                <button
                  id={id === "activities" ? "person-activities-retry" : "person-notes-retry"}
                  class="button-secondary"
                  type="button"
                  aria-controls={id === "activities" ? "person-activities-list" : "person-notes-list"}
                  hidden
                >Retry {title.toLowerCase()}</button>
                {id === "activities" && (
                  <div class="profile-section-footer">
                    <a class="button-secondary" data-activity-report-link href="/app/people">Open activity report</a>
                  </div>
                )}
              </section>
            )
            : id === "life-events"
            ? (
              <section
                id="profile-section-life-events"
                class="profile-section-card life-events-card"
                data-profile-section="life-events"
                data-person-life-events
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby="profile-section-life-events-heading"
              >
                <header class="profile-section-heading">
                  <SectionIcon name="life-events" class="profile-section-glyph" />
                  <div class="profile-section-title">
                    <h3 id="profile-section-life-events-heading">Life events</h3>
                    <span data-life-event-badge class="state-badge">Loading</span>
                  </div>
                </header>
                <p data-life-event-state class="section-state"><span class="sr-only">Loading life events…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <button data-life-event-retry class="button-secondary" type="button" hidden>Retry life events</button>
                <ol data-life-event-list class="life-event-list" aria-label="Saved life events" hidden></ol>
              </section>
            )
            : id === "tasks"
            ? (
              <section
                id="profile-section-tasks"
                class="profile-section-card tasks-section-card"
                data-profile-section="tasks"
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby="profile-section-tasks-heading"
              >
                <header class="profile-section-heading">
                  <SectionIcon name="tasks" class="profile-section-glyph" />
                  <div class="profile-section-title"><h3 id="profile-section-tasks-heading">Tasks</h3></div>
                  <button data-task-add class="button-primary profile-section-cta" type="button" hidden>Add task</button>
                </header>
                <p data-task-state class="section-state"><span class="sr-only">Loading tasks…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <button data-task-retry class="button-secondary" type="button" hidden>Retry tasks</button>
                <form data-task-form class="profile-fact-form task-form" hidden novalidate>
                  <label>Title <input name="title" maxlength="500" required /></label>
                  <label>Description (optional) <textarea name="description" maxlength="10000" rows="3"></textarea></label>
                  <label>Due time (optional) <input name="dueAt" type="datetime-local" /></label>
                  <label>State <select name="status"><option value="open">Open</option><option value="cancelled">Cancelled</option></select></label>
                  <p data-task-form-state class="section-state"></p>
                  <div class="form-actions"><button class="button-primary" type="submit">Save task</button><button data-task-cancel class="button-secondary" type="button">Cancel</button></div>
                </form>
                <div class="task-columns">
                  <div><h4>Open</h4><ul data-task-open-list class="task-list" aria-label="Open person tasks"></ul></div>
                  <div><h4>Completed</h4><ul data-task-completed-list class="task-list" aria-label="Completed person tasks"></ul></div>
                  <div><h4>Cancelled</h4><ul data-task-cancelled-list class="task-list" aria-label="Cancelled person tasks"></ul></div>
                  <button data-task-more class="button-secondary" type="button" hidden>Load more tasks</button>
                </div>
              </section>
            )
            : id === "reminders"
            ? (
              <section
                id="profile-section-reminders"
                class="profile-section-card"
                data-profile-section="reminders"
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby="profile-section-reminders-heading"
              >
                <header class="profile-section-heading">
                  <SectionIcon name="reminders" class="profile-section-glyph" />
                  <div class="profile-section-title"><h3 id="profile-section-reminders-heading">Reminders</h3></div>
                  <button data-reminder-add class="button-primary profile-section-cta" type="button" hidden>Add reminder</button>
                </header>
                <p data-reminder-state class="section-state"><span class="sr-only">Loading reminders…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <ul data-reminder-list class="task-list reminder-list" aria-label="Person reminders"></ul>
                <form data-reminder-form class="profile-fact-form" hidden novalidate>
                  <label>Title <input name="title" maxlength="500" required /></label>
                  <label>First date <input name="anchorOn" type="date" required /></label>
                  <label>Send time <input name="sendTime" type="time" value="09:00" required /></label>
                  <label>Repeat
                    <select name="recurrenceUnit">
                      <option value="none">Once</option>
                      <option value="day">Daily</option>
                      <option value="week">Weekly</option>
                      <option value="month">Monthly</option>
                      <option value="year">Yearly</option>
                    </select>
                  </label>
                  <label>Every <input name="recurrenceInterval" type="number" min="1" max="100" value="1" required /></label>
                  <div class="form-actions"><button class="button-primary" type="submit">Save reminder</button><button data-reminder-cancel class="button-secondary" type="button">Cancel</button></div>
                </form>
              </section>
            )
            : id === "gifts" || id === "debts"
            ? (
              <section
                id={`profile-section-${id}`}
                class="profile-section-card person-files-card"
                data-profile-section={id}
                data-person-gifts={id === "gifts" ? "gift" : "debt"}
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby={`profile-section-${id}-heading`}
              >
                <header class="profile-section-heading">
                  <SectionIcon name={sectionIcons[id]} class="profile-section-glyph" />
                  <div class="profile-section-title">
                    <h3 id={`profile-section-${id}-heading`}>{title}</h3>
                    <span data-gift-badge class="state-badge">Loading</span>
                  </div>
                  <button data-gift-add class="button-primary profile-section-cta" type="button" hidden>Add {id === "gifts" ? "gift" : "debt"}</button>
                </header>
                <p data-gift-state class="section-state"><span class="sr-only">Loading {title.toLowerCase()}…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <button data-gift-retry class="button-secondary" type="button" hidden>Retry loading</button>
                <ul data-gift-list class="person-file-list" aria-label={`Saved ${title.toLowerCase()}`}></ul>
                <form data-gift-form class="profile-fact-form" hidden novalidate>
                  {id === "gifts"
                    ? (
                      <>
                        <label>Gift name <input name="name" maxlength="500" required /></label>
                        <div class="form-grid">
                          <label>Status
                            <select name="status">
                              <option value="idea">Idea</option>
                              <option value="planned">Planned</option>
                              <option value="given">Given</option>
                              <option value="received">Received</option>
                            </select>
                          </label>
                          <label>Event time (optional) <input name="eventAt" type="datetime-local" /></label>
                          <label>Amount (optional) <input name="amount" inputmode="decimal" pattern="\d{1,15}(\.\d{1,4})?" /></label>
                          <label>Currency (with amount) <select name="currencyCode"><option value="">Select currency</option></select></label>
                        </div>
                        <label>Recipient (optional) <select name="recipientPersonId"><option value="">No recipient</option></select></label>
                        <label>Existing attachment (optional) <select name="attachmentFileId"><option value="">No attachment</option></select></label>
                        <label>Link (optional) <input name="url" type="url" maxlength="2000" /></label>
                        <label>Notes (optional) <textarea name="comment" maxlength="10000" rows="3"></textarea></label>
                      </>
                    )
                    : (
                      <>
                        <div class="form-grid">
                          <label>Direction
                            <select name="direction">
                              <option value="they_owe">They owe me</option>
                              <option value="i_owe">I owe them</option>
                            </select>
                          </label>
                          <label>Status
                            <select name="status">
                              <option value="open">Open</option>
                              <option value="settled">Settled</option>
                              <option value="cancelled">Cancelled</option>
                            </select>
                          </label>
                          <label>Amount <input name="amount" inputmode="decimal" pattern="\d{1,15}(\.\d{1,4})?" required /></label>
                          <label>Currency <select name="currencyCode" required></select></label>
                        </div>
                        <label>Reason (optional) <textarea name="reason" maxlength="10000" rows="3"></textarea></label>
                      </>
                    )}
                  <div class="form-actions">
                    <button class="button-primary" type="submit">Save</button>
                    <button data-gift-cancel class="button-secondary" type="button">Cancel</button>
                  </div>
                </form>
              </section>
            )
            : id === "documents" || id === "photos"
            ? (
              <section
                id={`profile-section-${id}`}
                class="profile-section-card person-files-card"
                data-profile-section={id}
                data-person-files={id === "documents" ? "document" : "photo"}
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby={`profile-section-${id}-heading`}
              >
                <header class="profile-section-heading">
                  <SectionIcon name={sectionIcons[id]} class="profile-section-glyph" />
                  <div class="profile-section-title">
                    <h3 id={`profile-section-${id}-heading`}>{title}</h3>
                    <span data-file-badge class="state-badge">Loading</span>
                  </div>
                  <button data-file-add class="button-primary profile-section-cta" type="button" hidden>Attach {id === "photos" ? "photo" : "document"}</button>
                </header>
                <p data-file-state class="section-state"><span class="sr-only">Loading {title.toLowerCase()}…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <button data-file-refresh class="button-secondary" type="button" hidden>Retry loading</button>
                <ul data-file-list class="person-file-list" aria-label={`Saved ${title.toLowerCase()}`}></ul>
                <form data-file-form class="profile-fact-form" hidden novalidate>
                  <label>Title <input name="title" maxlength="500" required /></label>
                  <label>
                    File
                    <input
                      name="file"
                      type="file"
                      accept={id === "photos" ? "image/jpeg,image/png,image/webp" : "application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document"}
                      required
                    />
                  </label>
                  <p class="form-hint">Maximum file size: 10 MB.</p>
                  <div class="form-actions">
                    <button class="button-primary" type="submit">Upload</button>
                    <button data-file-cancel class="button-secondary" type="button">Cancel</button>
                  </div>
                </form>
              </section>
            )
            : id === "audit-summary"
            ? (
              <section
                id="profile-section-audit-summary"
                class="profile-section-card audit-summary-card"
                data-profile-section="audit-summary"
                data-person-audit-summary
                data-section-state="loading"
                tabindex="-1"
                aria-labelledby="profile-section-audit-summary-heading"
              >
                <header class="profile-section-heading">
                  <SectionIcon name="audit" class="profile-section-glyph" />
                  <div class="profile-section-title">
                    <h3 id="profile-section-audit-summary-heading">Audit summary</h3>
                    <span data-person-audit-badge class="state-badge">Loading</span>
                  </div>
                </header>
                <p data-person-audit-state class="section-state"><span class="sr-only">Loading authorized audit summary…</span><span class="skeleton-lines" aria-hidden="true"><span class="skeleton skeleton-line" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-80" aria-hidden="true"></span><span class="skeleton skeleton-line skeleton-line-60" aria-hidden="true"></span></span></p>
                <ol data-person-audit-list class="audit-event-list" aria-label="Recent authorized person audit events"></ol>
                <div class="form-actions">
                  <a data-person-audit-link class="button-secondary" href="/app/people" hidden>Open full audit history</a>
                  <button data-person-audit-retry class="button-secondary" type="button" hidden>Retry audit summary</button>
                </div>
              </section>
            )
            : (
              <section
                id={`profile-section-${id}`}
                class="profile-section-card unavailable-section-card"
                data-profile-section={id}
                data-section-state="unavailable"
                tabindex="-1"
                aria-labelledby={`profile-section-${id}-heading`}
              >
                <header class="profile-section-heading">
                  <div class="profile-section-title">
                    <h3 id={`profile-section-${id}-heading`}>{title}</h3>
                    <span class="state-badge">Unavailable</span>
                  </div>
                </header>
                <p>This section is not available yet. No empty result is being inferred and no saved data has changed.</p>
              </section>
              ))}
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
</ApplicationLayout>

<script>
  import { mountPeopleProfile } from "../../lib/people-profile.ts";
  void mountPeopleProfile();
</script>
