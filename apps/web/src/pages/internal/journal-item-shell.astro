---
import Breadcrumb from "../../components/Breadcrumb.astro";
import ApplicationLayout from "../../layouts/ApplicationLayout.astro";
export const prerender = true;
import {
  buttonVariants,
} from "../../components/ui/variants.ts";
---

<ApplicationLayout current="journal" description="Read one personal journal item." pageId="journal.item" title="Journal item — Kinship">
  <main id="main-content" class="page-frame journal-page" data-journal-detail tabindex="-1">
    <Breadcrumb trail={[
      { href: "/app/journal", label: "Journal" },
      { label: "Journal item" },
    ]} />
    <header class="page-heading"><div><p class="eyebrow">Personal history · <span data-workspace-name></span></p><h1>Journal item</h1></div></header>
    <p data-journal-state class="section-state" role="status" aria-live="polite">Loading journal item…</p>
    <button data-journal-retry class={buttonVariants({ variant: "outline" })} type="button" hidden>Retry item</button>
    <ol data-journal-list class="journal-list" aria-label="Journal item"></ol>
  </main>
</ApplicationLayout>

<script>
  import { mountJournal } from "../../lib/journal.ts";
  void mountJournal();
</script>
