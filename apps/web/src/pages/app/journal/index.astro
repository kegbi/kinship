---
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
import { buttonVariants } from "../../../components/ui/variants.ts";
---

<ApplicationLayout current="journal" description="Maintain ordered personal journal posts, day ratings, and linked activities." pageId="journal.index" title="Journal — Kinship">
  <main id="main-content" class="page-frame journal-page" tabindex="-1">
    <header class="page-heading"><div><p class="eyebrow">Personal history · <span data-workspace-name></span></p><h1>Journal</h1></div><button data-journal-add class={buttonVariants()} type="button" disabled>Add item</button></header>
    <div class="contents" data-journal-surface="timeline">
      <p data-journal-state class="section-state" role="status" aria-live="polite">Loading journal…</p>
      <button data-journal-retry class={buttonVariants({ variant: "outline" })} type="button" hidden>Retry journal</button>
      <ol id="journal-timeline" data-journal-list class="journal-list" aria-label="Journal timeline"></ol>
    </div>
  </main>
</ApplicationLayout>

<script>
  // The journal island (`features/journal/`, GAP-033) takes over the surface
  // above and renders Add item into the heading once it knows the workspace;
  // until then Add item stays disabled, as drawn.
  import { mountJournal } from "../../../features/journal/journal.tsx";
  void mountJournal();
</script>
