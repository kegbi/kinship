---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SettingsNavigation from "../../../components/SettingsNavigation.astro";
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
---

<ApplicationLayout
  current="settings"
  description="Invite people and review active members in your Kinship workspace."
  pageId="settings.members"
  title="Members — Kinship"
>
  <main id="main-content" class="page-frame settings-page" tabindex="-1" data-requires-workspace-admin>
    <div class="settings-layout">
      <SettingsNavigation currentPage="settings.members" />
      <div class="settings-content members-page">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { label: "Members" },
    ]} />
    <header class="settings-heading">
      <div>
        <p class="eyebrow">Workspace settings</p>
        <h1>Members</h1>
        <p>Invite people into this workspace and review who currently has access.</p>
      </div>
    </header>

    <section class="member-section invite-panel" aria-labelledby="invite-heading">
      <div class="section-heading">
        <div><p class="section-kicker">Single-use access</p><h2 id="invite-heading">Invite a member</h2></div>
      </div>
      <p>The invitation is valid for seven days and can be accepted only by the invited email address.</p>
      <form method="post" id="invitation-form" class="invitation-form" novalidate>
        <label>Email address<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
        <label>Role<select name="role"><option value="member">Member</option><option value="admin">Admin</option></select></label>
        <button type="submit">Send invitation</button>
      </form>
      <p id="invitation-status" class="inline-status" role="status" aria-live="polite"></p>
    </section>

    <section class="member-section" aria-labelledby="active-members-heading">
      <div class="section-heading"><h2 id="active-members-heading">Active members</h2><span id="member-count" class="state-badge calm">Loading…</span></div>
      <div id="members-state" class="list-state" role="status" aria-live="polite">Loading active members securely…</div>
      <ul id="member-list" class="member-list" hidden></ul>
    </section>

    <section class="member-section" aria-labelledby="member-admin-heading">
      <div class="section-heading"><h2 id="member-admin-heading">Member administration</h2><span class="state-badge calm">Role-safe</span></div>
      <p id="managed-state" class="list-state" role="status" aria-live="polite">Loading role controls…</p>
      <ul id="managed-list" class="member-list managed-list" hidden></ul>
    </section>

    <section class="member-section" aria-labelledby="pending-invitations-heading">
      <div class="section-heading"><h2 id="pending-invitations-heading">Pending invitations</h2><span id="invitation-count" class="state-badge calm">Loading…</span></div>
      <div id="pending-state" class="list-state" role="status" aria-live="polite">Loading pending invitations…</div>
      <ul id="pending-list" class="member-list" hidden></ul>
    </section>
      </div>
    </div>
  </main>
</ApplicationLayout>

<script>
  import { mountMembersPage } from "../../../lib/members.ts";
  void mountMembersPage();
</script>
