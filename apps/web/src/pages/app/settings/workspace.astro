---
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
---
<ApplicationLayout current="settings" description="Manage active workspace identity and defaults." pageId="settings.workspace" title="Workspace settings — Kinship">
  <main id="main-content" class="page-frame settings-page detail-settings" tabindex="-1" data-requires-workspace-admin>
    <header class="settings-heading"><div><p class="eyebrow">Workspace settings</p><h1>General</h1><p>Identity and defaults apply only to this active workspace.</p></div><a class="button-link secondary-link" href="/app/settings">All settings</a></header>
    <form id="workspace-form" class="settings-form">
      <p id="settings-errors" class="form-error-summary" role="alert" tabindex="-1" hidden></p>
      <label>Workspace name<input name="name" maxlength="200" required /></label><label>Workspace slug<input name="slug" maxlength="100" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" /></label>
      <label>Default locale<input name="defaultLocale" maxlength="35" pattern="[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*" required /></label><label>Default time zone<input name="defaultTimezone" maxlength="100" aria-describedby="default-timezone-error" /><small id="default-timezone-error" data-field-error="defaultTimezone"></small></label>
      <label>Default currency<input name="defaultCurrencyCode" maxlength="3" pattern="[A-Za-z]{3}" aria-describedby="default-currency-error" /><small id="default-currency-error" data-field-error="defaultCurrencyCode"></small></label><label>Default reminder time<input name="defaultReminderTime" type="time" required /></label>
      <button type="submit">Save changes</button><p id="settings-dirty" role="status" aria-live="polite"></p><p id="settings-status" role="status" aria-live="polite"></p>
    </form>
  </main>
</ApplicationLayout>
<script>import { mountWorkspaceSettings } from "../../../lib/settings.ts"; void mountWorkspaceSettings();</script>
