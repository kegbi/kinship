---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SettingsNavigation from "../../../components/SettingsNavigation.astro";
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
import "../../../styles/page-settings.css";
export const prerender = true;
import {
  badgeVariants,
  cardVariants,
} from "../../../components/ui/variants.ts";
---
<ApplicationLayout current="settings" description="Review and revoke your active Kinship sessions." pageId="settings.security" title="Security & sessions — Kinship">
  <main id="main-content" class="page-frame settings-page" tabindex="-1">
    <div class="settings-layout">
      <SettingsNavigation currentPage="settings.security" />
      <div class="settings-content detail-settings">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { label: "Security & sessions" },
    ]} />
    <header class="settings-heading"><div><p class="eyebrow">Personal security</p><h1>Security &amp; sessions</h1><p>Review only your active sessions. Revoking the current session signs you out immediately.</p></div></header>
    <section class={cardVariants({ className: "member-section" })} data-settings-security><div class="section-heading"><h2>Active sessions</h2><span id="session-count" class={badgeVariants({ variant: "secondary" })}>Loading…</span></div><p id="settings-status" role="status" aria-live="polite">Loading sessions securely…</p><ul id="session-list" class="member-list"></ul></section>
      </div>
    </div>
  </main>
</ApplicationLayout>
<script>
  // The sessions list is an island (`features/settings/security/`, GAP-033)
  // that takes over the section drawn above.
  import { mountSecuritySettings } from "../../../features/settings/security/security-sessions.tsx";
  void mountSecuritySettings();
</script>
