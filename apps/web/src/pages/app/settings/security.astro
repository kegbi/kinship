---
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
---
<ApplicationLayout current="settings" description="Review and revoke your active Kinship sessions." pageId="settings.security" title="Security & sessions — Kinship">
  <main id="main-content" class="page-frame settings-page detail-settings" tabindex="-1">
    <header class="settings-heading"><div><p class="eyebrow">Personal security</p><h1>Security &amp; sessions</h1><p>Review only your active sessions. Revoking the current session signs you out immediately.</p></div><a class="button-link secondary-link" href="/app/settings">All settings</a></header>
    <section class="member-section"><div class="section-heading"><h2>Active sessions</h2><span id="session-count" class="state-badge calm">Loading…</span></div><p id="settings-status" role="status" aria-live="polite">Loading sessions securely…</p><ul id="session-list" class="member-list"></ul></section>
  </main>
</ApplicationLayout>
<script>import { mountSecuritySettings } from "../../../lib/settings.ts"; void mountSecuritySettings();</script>
