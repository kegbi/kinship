---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SettingsNavigation from "../../../components/SettingsNavigation.astro";
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
import {
  buttonVariants,
  cardVariants,
} from "../../../components/ui/variants.ts";
---
<ApplicationLayout current="settings" description="Manage personal locale, regional, and display preferences." pageId="settings.preferences" title="Preferences — Kinship">
  <main id="main-content" class="page-frame settings-page" tabindex="-1">
    <div class="settings-layout">
      <SettingsNavigation currentPage="settings.preferences" />
      <div class="settings-content detail-settings">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { label: "Preferences" },
    ]} />
    <header class="settings-heading"><div><p class="eyebrow">Personal settings</p><h1>Preferences</h1><p>These values apply only to your membership in the active workspace.</p></div></header>
    <section class={cardVariants({ className: "settings-form" })} aria-labelledby="appearance-heading">
      <h2 id="appearance-heading">Appearance</h2>
      <label for="theme-preference">Theme</label>
      <select id="theme-preference" name="theme" disabled>
        <option value="system">System</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
      <p id="theme-status" class="section-state" role="status" aria-live="polite">Loading your theme preference…</p>
    </section>
    <div class="contents" data-settings-preferences>
    <form method="post" id="preferences-form" class={cardVariants({ className: "settings-form" })}>
      <p id="settings-errors" class="form-error-summary" role="alert" tabindex="-1" hidden></p>
      <label>Locale<input name="locale" maxlength="35" pattern="[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*" required disabled /></label>
      <label>Time zone<input name="timezone" maxlength="100" placeholder="Europe/Belgrade" aria-describedby="timezone-error" disabled /><small id="timezone-error" data-field-error="timezone"></small></label>
      <label>Temperature<select name="temperatureScale" required disabled><option value="celsius">Celsius</option><option value="fahrenheit">Fahrenheit</option></select></label>
      <label>Measurements<select name="measurementSystem" required disabled><option value="metric">Metric</option><option value="imperial">Imperial</option></select></label>
      <label>Currency<input name="currencyCode" maxlength="3" pattern="[A-Za-z]{3}" placeholder="EUR" aria-describedby="currency-error" disabled /><small id="currency-error" data-field-error="currencyCode"></small></label>
      <label>Contact sorting<select name="contactSortOrder" required disabled><option value="given_name_asc">Given name</option><option value="family_name_asc">Family name</option></select></label>
      <label>Name display<select name="contactNameOrder" required disabled><option value="given_family_nickname">Given then family</option><option value="family_given_nickname">Family then given</option></select></label>
      <label class="check-label"><input name="fluidLayout" type="checkbox" disabled /> Use fluid layout</label>
      <label>Reminder delivery<select name="reminderDelivery" aria-describedby="reminder-delivery-hint" required disabled><option value="in_app">In the app</option><option value="email">Email</option><option value="both">In the app and by email</option></select></label>
      <label>Daily email digest<input name="digestTime" type="time" aria-describedby="reminder-delivery-hint digest-time-error" disabled /><small id="digest-time-error" data-field-error="digestTime"></small></label>
      <p id="reminder-delivery-hint">Email reminders go to your verified email address; without one, reminders stay in the app. A delivery change applies to reminders scheduled from now on. A digest time applies to every email reminder still waiting: they arrive together at that time in your time zone. Leave it empty to get each one when it is due.</p>
      <button type="submit" class={buttonVariants()} disabled>Save changes</button><p id="settings-dirty" role="status" aria-live="polite"></p><p id="settings-status" role="status" aria-live="polite">Loading your preferences…</p>
    </form>
    </div>
      </div>
    </div>
  </main>
</ApplicationLayout>
<script>
  // The preferences form is an island (`features/settings/preferences/`,
  // GAP-033) that takes over the disabled form drawn above.
  import { mountPreferenceSettings } from "../../../features/settings/preferences/preference-settings.tsx";
  import { mountThemePreferenceControl } from "../../../lib/theme.ts";
  void mountPreferenceSettings();
  void mountThemePreferenceControl();
</script>
