---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
---
<ApplicationLayout current="settings" description="Manage personal locale, regional, and display preferences." pageId="settings.preferences" title="Preferences — Kinship">
  <main id="main-content" class="page-frame settings-page detail-settings" tabindex="-1">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { label: "Preferences" },
    ]} />
    <header class="settings-heading"><div><p class="eyebrow">Personal settings</p><h1>Preferences</h1><p>These values apply only to your membership in the active workspace.</p></div></header>
    <form id="preferences-form" class="settings-form">
      <p id="settings-errors" class="form-error-summary" role="alert" tabindex="-1" hidden></p>
      <label>Locale<input name="locale" maxlength="35" pattern="[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*" required disabled /></label>
      <label>Time zone<input name="timezone" maxlength="100" placeholder="Europe/Belgrade" aria-describedby="timezone-error" disabled /><small id="timezone-error" data-field-error="timezone"></small></label>
      <label>Temperature<select name="temperatureScale" required disabled><option value="celsius">Celsius</option><option value="fahrenheit">Fahrenheit</option></select></label>
      <label>Measurements<select name="measurementSystem" required disabled><option value="metric">Metric</option><option value="imperial">Imperial</option></select></label>
      <label>Currency<input name="currencyCode" maxlength="3" pattern="[A-Za-z]{3}" placeholder="EUR" aria-describedby="currency-error" disabled /><small id="currency-error" data-field-error="currencyCode"></small></label>
      <label>Contact sorting<select name="contactSortOrder" required disabled><option value="given_name_asc">Given name</option><option value="family_name_asc">Family name</option></select></label>
      <label>Name display<select name="contactNameOrder" required disabled><option value="given_family_nickname">Given then family</option><option value="family_given_nickname">Family then given</option></select></label>
      <label class="check-label"><input name="fluidLayout" type="checkbox" disabled /> Use fluid layout</label>
      <button type="submit" disabled>Save changes</button><p id="settings-dirty" role="status" aria-live="polite"></p><p id="settings-status" role="status" aria-live="polite">Loading your preferences…</p>
    </form>
  </main>
</ApplicationLayout>
<script>import { mountPreferenceSettings } from "../../../lib/settings.ts"; void mountPreferenceSettings();</script>
