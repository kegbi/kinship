---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SettingsNavigation from "../../../components/SettingsNavigation.astro";
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
import {
  buttonVariants,
} from "../../../components/ui/variants.ts";
---
<ApplicationLayout current="settings" description="Create and download portable workspace exports." pageId="settings.export" title="Export — Kinship">
  <main id="main-content" class="page-frame settings-page" tabindex="-1" data-requires-workspace-admin data-export-settings>
    <div class="settings-layout">
      <SettingsNavigation currentPage="settings.export" />
      <div class="settings-content export-page">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { label: "Export" },
    ]} />
    <header class="settings-heading"><div><p class="eyebrow">Data settings</p><h1>Export</h1><p>Portable person data with versioned checksums and short-lived downloads.</p></div><button data-export-create class={buttonVariants()} type="button" disabled>Create export</button></header>
    <p data-export-state class="section-state" role="status" aria-live="polite">Loading export history…</p>
    <button data-export-retry class={buttonVariants({ variant: "outline" })} type="button" hidden>Retry</button>
    <section aria-labelledby="export-history-heading"><h2 id="export-history-heading">Export history</h2><ol data-export-history class="import-history" aria-label="Export history"></ol></section>
      </div>
    </div>
  </main>
</ApplicationLayout>
<script>import { mountExports } from "../../../lib/exports.ts"; void mountExports();</script>
