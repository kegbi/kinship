---
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import SettingsNavigation from "../../../../components/SettingsNavigation.astro";
import ApplicationLayout from "../../../../layouts/ApplicationLayout.astro";
export const prerender = true;
---
<ApplicationLayout current="settings" description="Validate and commit a bounded Monica JSON export." pageId="settings.import-new" title="New import — Kinship">
  <main id="main-content" class="page-frame settings-page" tabindex="-1" data-requires-workspace-admin data-import-new>
    <div class="settings-layout">
      <SettingsNavigation currentPage="settings.import-new" />
      <div class="settings-content import-page">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { href: "/app/settings/import", label: "Import" },
      { label: "New import" },
    ]} />
    <header class="settings-heading"><div><p class="eyebrow">Data settings</p><h1>New import</h1><p>Monica JSON export, version 1.</p></div></header>
    <div class="contents" data-import-new-surface>
    <form method="post" data-import-form class="import-form">
      <label for="import-source">Monica JSON export</label>
      <input id="import-source" name="source" type="file" accept="application/json,.json" required />
      <p data-import-detection class="section-state" role="status" aria-live="polite">Choose an export to detect its format.</p>
      <button type="submit">Validate dry run</button>
    </form>
    <p data-import-state class="section-state" role="status" aria-live="polite"></p>
    <section data-import-report hidden aria-labelledby="import-report-heading">
      <h2 id="import-report-heading">Dry-run report</h2>
      <dl class="import-counts"><div><dt>Contacts</dt><dd data-import-contacts></dd></div><div><dt>Orphans</dt><dd data-import-orphans></dd></div><div><dt>Missing files</dt><dd data-import-missing></dd></div><div><dt>Legacy identities discarded</dt><dd data-import-credentials></dd></div><div><dt>Unsupported records</dt><dd data-import-unsupported></dd></div></dl>
      <ul data-import-diagnostics></ul>
      <label class="confirmation-control"><input data-import-confirm type="checkbox" /> I confirm this validated import</label>
      <button data-import-commit type="button" disabled>Commit import</button>
    </section>
    </div>
      </div>
    </div>
  </main>
</ApplicationLayout>
<script>
  // The new-import flow is an island (`features/settings/imports/`, GAP-033)
  // that takes over the region drawn above; a validation submitted before it
  // knows its workspace is held, never submitted natively.
  import { mountNewImport } from "../../../../features/settings/imports/import-new.tsx";
  void mountNewImport();
</script>
