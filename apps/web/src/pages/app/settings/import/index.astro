---
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import SettingsNavigation from "../../../../components/SettingsNavigation.astro";
import ApplicationLayout from "../../../../layouts/ApplicationLayout.astro";
export const prerender = true;
import {
  buttonVariants,
} from "../../../../components/ui/variants.ts";
---
<ApplicationLayout current="settings" description="Review Monica import history." pageId="settings.import" title="Import history — Kinship">
  <main id="main-content" class="page-frame settings-page" tabindex="-1" data-requires-workspace-admin data-import-index>
    <div class="settings-layout">
      <SettingsNavigation currentPage="settings.import" />
      <div class="settings-content import-page">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { label: "Import" },
    ]} />
    <header class="settings-heading"><div><p class="eyebrow">Data settings</p><h1>Import</h1><p>Validated Monica imports and their current status.</p></div><a class={buttonVariants({ className: "mt-(--space-4)", shape: "pill" })} href="/app/settings/import/new">New import</a></header>
    <p data-import-state class="section-state" role="status" aria-live="polite">Loading import history…</p>
    <button data-import-retry class={buttonVariants({ variant: "outline" })} type="button" hidden>Retry</button>
    <ol data-import-history class="import-history" aria-label="Import history"></ol>
      </div>
    </div>
  </main>
</ApplicationLayout>
<script>import { mountImports } from "../../../../lib/imports.ts"; void mountImports();</script>
