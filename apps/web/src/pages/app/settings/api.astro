---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SettingsNavigation from "../../../components/SettingsNavigation.astro";
import Code from "../../../components/api-reference/Code.astro";
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
import "../../../styles/page-settings.css";
import {
  ACCESS_TEXT,
  agentConfigurations,
  cautionText,
  configurationBlocks,
  mcpEndpoint,
  SCOPE_PRESETS,
  scopeGroups,
  TOKEN_PLACEHOLDER,
} from "../../../features/settings/api-access/api-access.ts";
export const prerender = true;
import {
  badgeVariants,
  buttonVariants,
} from "../../../components/ui/variants.ts";
// The island fills in this page's own origin once it mounts.
const staticEndpoint = mcpEndpoint("https://<your-kinship-origin>");
const staticBlocks = configurationBlocks(agentConfigurations(staticEndpoint));
---

<ApplicationLayout
  current="settings"
  description="Create scoped personal API tokens, and inspect and revoke every token in the workspace."
  pageId="settings.api-access"
  title="API access — Kinship"
>
  <main id="main-content" class="page-frame settings-page" tabindex="-1" data-requires-workspace-admin data-api-access>
    <div class="settings-layout">
      <SettingsNavigation currentPage="settings.api-access" />
      <div class="settings-content api-access-page">
    <Breadcrumb trail={[
      { href: "/app/settings", label: "Settings" },
      { label: "API access" },
    ]} />
    <header class="settings-heading">
      <div><p class="eyebrow">Developer settings</p><h1>API access</h1><p>Personal credentials for approved programmatic access to this workspace.</p><p><a href="/docs/api">Read the API reference</a> for grants, examples, and the OpenAPI download.</p></div>
    </header>
    <div class="contents" data-api-surface>
    <p data-api-state class="api-access-state" role="status" aria-live="polite"></p>

    <section class="api-access-section" aria-labelledby="create-token-heading">
      <header><p class="scope-label">Personal credential</p><h2 id="create-token-heading">Create API token</h2></header>
      <form method="post" data-api-create class="api-token-form" novalidate>
        <label>Token name<input name="name" type="text" maxlength="100" autocomplete="off" required /></label>
        <label>Expiry <span class="optional-label">Optional</span><input name="expiresAt" type="datetime-local" /></label>
        <fieldset class="scope-picker"><legend>Scopes</legend>
          <p>Grants are independent: none implies another, and a write grant does not include reading. For full task automation, select Read tasks, Create tasks, and Edit and complete tasks.</p>
          <div class="scope-presets">{SCOPE_PRESETS.map((preset) => <div><button type="button" class={buttonVariants({ variant: "outline" })} aria-describedby={`preset-${preset.id}-detail`} disabled>{preset.label}</button><small id={`preset-${preset.id}-detail`}>{preset.detail}</small></div>)}</div>
          {scopeGroups(undefined).map((group) => <fieldset class="scope-group"><legend>{group.title}</legend>{group.choices.map(({ scope, label, detail, access, caution }) => <label class="scope-choice" data-scope-access={access}><input name="scopes" type="checkbox" value={scope} aria-label={label} aria-describedby={[`scope-${scope}-access`, ...(caution ? [`scope-${scope}-caution`] : []), `scope-${scope}-detail`].join(" ")} /><span><span class="scope-choice-title">{label}<span id={`scope-${scope}-access`} class={badgeVariants({ variant: access === "read" ? "secondary" : "warning" })}>{ACCESS_TEXT[access]}</span>{caution && <span id={`scope-${scope}-caution`} class={badgeVariants(caution === "destructive" ? { className: "bg-(--danger-soft) text-(--danger-strong)" } : {})}>{cautionText(caution)}</span>}</span><small id={`scope-${scope}-detail`}>{detail}</small></span></label>)}</fieldset>)}
        </fieldset>
        <button type="submit" disabled>Create token</button>
      </form>
    </section>

    <section data-api-secret-panel class="api-secret-panel" aria-labelledby="api-secret-heading" hidden>
      <header><p class="scope-label">Shown once</p><h2 id="api-secret-heading">Copy your token now</h2></header>
      <p>This secret cannot be shown again after you leave or dismiss this view.</p>
      <div class="api-secret-control"><input data-api-secret aria-label="New API token secret" readonly /><button data-api-copy type="button">Copy</button></div>
      <button data-api-dismiss class={buttonVariants({ variant: "outline" })} type="button">I have saved it</button>
    </section>

    <section class="api-access-section" aria-labelledby="connect-agent-heading" data-api-connect>
      <header><p class="scope-label">Model Context Protocol</p><h2 id="connect-agent-heading">Connect an AI agent</h2></header>
      <p>An AI agent connects to this workspace's MCP endpoint with a personal API token and sees only the tools its scopes allow. The agent can do whatever the token's scopes allow in this workspace, with the role of the member who created the token. Revoking the token cuts the agent off.</p>
      <div class="api-secret-control"><input data-api-endpoint aria-label="MCP endpoint URL" readonly value={staticEndpoint} /><button type="button" disabled>Copy endpoint URL</button></div>
      <div class="agent-configuration">{staticBlocks.map(({ heading, name, text }) => <div><h3>{heading}</h3><Code label={name} text={text} /><button type="button" class={buttonVariants({ variant: "outline" })} disabled>{`Copy ${name}`}</button></div>)}</div>
      <p>Replace <code>{TOKEN_PLACEHOLDER}</code> with a token's secret, or copy the filled-in configuration while a new token is shown. Each operation and the grant it needs is listed in the <a href="/docs/api">API reference</a>.</p>
    </section>

    <section class="api-access-section" aria-labelledby="api-token-list-heading">
      <header><p class="scope-label">Workspace-bound</p><h2 id="api-token-list-heading">Workspace API tokens</h2></header>
      <p>Every personal API token in this workspace, whoever created it. Revoke any you do not recognize.</p>
      <p data-api-empty hidden>No API tokens yet.</p>
      <ul data-api-list class="api-token-list" aria-label="Workspace API tokens"></ul>
    </section>
    </div>
      </div>
    </div>
  </main>
</ApplicationLayout>

<script>
  // The API access page is an island (`features/settings/api-access/`,
  // GAP-033) that takes over the region drawn above.
  import { mountApiAccess } from "../../../features/settings/api-access/api-access.tsx";
  void mountApiAccess();
</script>
