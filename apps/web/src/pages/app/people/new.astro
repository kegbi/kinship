---
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
export const prerender = true;
---

<ApplicationLayout
  current="people"
  description="Add a person to your active Kinship workspace."
  pageId="people.create"
  title="Add a person — Kinship"
>
  <main id="main-content" class="page-frame people-create-page" tabindex="-1">
    <header id="people-create-heading" class="page-heading">
      <div>
        <p class="eyebrow">People · <span data-workspace-name></span></p>
        <h1>Add a person</h1>
      </div>
      <p class="honesty-note">Start with only what you know. Unknown names stay unknown, and you can mark an incomplete identity explicitly.</p>
    </header>

    <form id="people-create-form" class="person-form" novalidate>
      <p id="people-form-errors" class="form-error-summary" role="alert" tabindex="-1" hidden></p>
      <div class="name-grid">
        <div class="name-field">
          <label>
            Given name
            <input name="givenName" maxlength="200" autocomplete="given-name" aria-describedby="person-given-name-error" />
          </label>
          <small id="person-given-name-error" data-field-error="givenName"></small>
        </div>
        <label>
          Middle name <span>Optional</span>
          <input name="middleName" maxlength="200" autocomplete="additional-name" />
        </label>
        <label>
          Family name <span>Optional</span>
          <input name="familyName" maxlength="200" autocomplete="family-name" />
        </label>
        <label>
          Nickname <span>Optional</span>
          <input name="nickname" maxlength="200" />
        </label>
      </div>
      <div class="partial-person-control">
        <input id="person-is-partial" name="isPartial" type="checkbox" />
        <span class="partial-person-copy"><label for="person-is-partial"><strong>Some identity details are unknown</strong></label><small>Use this when the given name or other identity information is incomplete. Kinship will not invent a value.</small><small data-field-error="isPartial"></small></span>
      </div>
      <section id="duplicate-warning" class="duplicate-warning" role="alert" tabindex="-1" hidden>
        <h2>Possible duplicate</h2>
        <p id="duplicate-detail"></p>
        <div class="form-actions">
          <button id="create-anyway" type="button" class="secondary-action">Create anyway</button>
          <button id="review-person" type="button">Review the names</button>
        </div>
      </section>
      <div class="form-actions">
        <button id="save-person" type="submit">Save person</button>
        <button id="save-add-another" type="submit" class="secondary-action">Save and add another</button>
      </div>
      <p id="people-create-status" role="status" aria-live="polite"></p>
    </form>

    <section id="created-person" class="created-person" tabindex="-1" hidden>
      <p class="eyebrow">Person created</p>
      <h1 id="created-person-name" tabindex="-1"><span class="sr-only">Created person</span></h1>
      <p id="created-person-partial" class="state-badge" hidden>Partial identity · unknown values preserved</p>
      <dl class="identity-summary">
        <div><dt>Given name</dt><dd data-person-field="givenName"></dd></div>
        <div><dt>Middle name</dt><dd data-person-field="middleName"></dd></div>
        <div><dt>Family name</dt><dd data-person-field="familyName"></dd></div>
        <div><dt>Nickname</dt><dd data-person-field="nickname"></dd></div>
      </dl>
      <aside class="profile-next-step">
        <h2>Identity saved</h2>
        <p>This canonical page currently shows the saved identity. Additional profile sections are not available yet.</p>
      </aside>
      <a class="button-link" href="/app/people/new">Add another person</a>
    </section>
  </main>
</ApplicationLayout>

<script>
  import { mountPeopleCreate } from "../../../lib/people-create.ts";
  void mountPeopleCreate();
</script>
