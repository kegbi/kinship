---
import ApplicationLayout from "../../../layouts/ApplicationLayout.astro";
import LoadMore from "../../../components/LoadMore.astro";
export const prerender = true;
---

<ApplicationLayout
  current="tasks"
  description="Create, change, complete, and reopen workspace or person tasks."
  pageId="tasks.index"
  title="Tasks — Kinship"
>
  <main id="main-content" class="page-frame tasks-page" tabindex="-1">
    <header class="page-heading">
      <div><p class="eyebrow">Planning · <span data-workspace-name></span></p><h1>Tasks</h1></div>
      <button data-task-add class="button-primary" type="button" disabled>Add task</button>
    </header>
    <section class="task-filters" aria-label="Task filters">
      <label>State <select data-task-status-filter><option value="">All states</option><option value="open">Open</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select></label>
      <label>Person <select data-task-person-filter><option value="">All people and workspace tasks</option></select></label>
      <button data-task-people-more class="button-secondary" type="button" hidden>Load more people</button>
    </section>
    <p data-task-state class="section-state" role="status" aria-live="polite">Loading tasks…</p>
    <button data-task-retry class="button-secondary" type="button" hidden>Retry tasks</button>
    <form method="post" data-task-form class="profile-fact-form task-form" hidden novalidate>
      <h2>Task details</h2>
      <label>Title <input name="title" maxlength="500" required /></label>
      <label>Description (optional) <textarea name="description" maxlength="10000" rows="3"></textarea></label>
      <label>Due time (optional) <input name="dueAt" type="datetime-local" /></label>
      <label>Person (optional) <select name="personId"><option value="">Workspace task</option></select></label>
      <label>State <select name="status"><option value="open">Open</option><option value="cancelled">Cancelled</option></select></label>
      <p data-task-form-state class="section-state" role="status" aria-live="polite"></p>
      <div class="form-actions"><button class="button-primary" type="submit">Save task</button><button data-task-cancel type="button">Cancel</button></div>
    </form>
    <div class="task-columns">
      <section aria-labelledby="open-tasks-heading"><h2 id="open-tasks-heading">Open</h2><ul data-task-open-list class="task-list" aria-label="Open tasks"></ul></section>
      <section aria-labelledby="completed-tasks-heading"><h2 id="completed-tasks-heading">Completed</h2><ul data-task-completed-list class="task-list" aria-label="Completed tasks"></ul></section>
      <section aria-labelledby="cancelled-tasks-heading"><h2 id="cancelled-tasks-heading">Cancelled</h2><ul data-task-cancelled-list class="task-list" aria-label="Cancelled tasks"></ul></section>
      <LoadMore list="tasks" label="Load more tasks" />
    </div>
  </main>
</ApplicationLayout>

<script>
  import { mountTaskSurface } from "../../../lib/tasks.ts";
  void mountTaskSurface();
</script>
