---
/**
 * Decorative section glyphs for the person workspace. Every section carries a
 * distinct symbol next to its heading so blocks read differently at a glance;
 * the glyph is aria-hidden because the heading text remains the label.
 */
import { SECTION_ICON_PATHS, type SectionIconName } from "../lib/section-icons.ts";

export type { SectionIconName };

interface Props {
  readonly name: SectionIconName;
  readonly class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={["section-icon", className]} data-section-icon={name} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={SECTION_ICON_PATHS[name]} />
</span>
