---
/**
 * A profile-fact rail block — contact methods, addresses, work, pets, food
 * preferences, or first meeting — that `lib/profile-facts.ts` owns and fills
 * from the fact's contract (GAP-029).
 */
import PersonSection from "./PersonSection.astro";
import type { PersonSectionEntry } from "../../features/person/sections.ts";
import { buttonVariants } from "../ui/variants.ts";

interface Props {
  readonly section: PersonSectionEntry;
}

const { section } = Astro.props;
const title = section.title.toLowerCase();
---

<PersonSection section={section} attributes={{ "data-profile-fact-section": section.id }} state={{ "data-profile-fact-state": "" }}>
  <button
    slot="action"
    data-profile-fact-add
    data-profile-fact-add-icon
    class={buttonVariants({ className: "profile-rail-add" })}
    type="button"
    aria-label={`Add ${title}`}
    hidden
  ><span aria-hidden="true">+</span></button>
  <ul data-profile-fact-list class="profile-fact-list" aria-label={`Saved ${title}`}></ul>
  <form method="post" data-profile-fact-form class="profile-fact-form" hidden novalidate></form>
</PersonSection>
