---
import { cn } from "../lib/utils.ts";
import { breadcrumbVariants, skeletonVariants } from "./ui/variants.ts";

interface BreadcrumbEntry {
  readonly href?: string;
  readonly label: string;
  readonly pending?: boolean;
}

interface Props {
  readonly class?: string;
  readonly trail: readonly BreadcrumbEntry[];
}

const { class: className = "page-breadcrumb", trail } = Astro.props;
---

<nav class={cn(breadcrumbVariants.list, className)} aria-label="Breadcrumb">
  {trail.map((entry, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      {index === trail.length - 1
        ? <span aria-current="page">{entry.label}</span>
        : entry.pending
        ? <a class={breadcrumbVariants.link} data-breadcrumb-person href={entry.href}><span class={skeletonVariants({ shape: "chip" })} data-slot="skeleton" aria-hidden="true"></span><span class="sr-only">{entry.label}</span></a>
        : entry.href
        ? <a class={breadcrumbVariants.link} href={entry.href}>{entry.label}</a>
        : null}
    </>
  ))}
</nav>
