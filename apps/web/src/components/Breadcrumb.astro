---
interface BreadcrumbEntry {
  readonly href?: string;
  readonly label: string;
  readonly pending?: boolean;
}

interface Props {
  readonly class?: string;
  readonly trail: readonly BreadcrumbEntry[];
}

const { class: className = "page-breadcrumb", trail } = Astro.props;
---

<nav class={className} aria-label="Breadcrumb">
  {trail.map((entry, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      {index === trail.length - 1
        ? <span aria-current="page">{entry.label}</span>
        : entry.pending
        ? <a data-breadcrumb-person href={entry.href}><span class="skeleton skeleton-chip" aria-hidden="true"></span><span class="sr-only">{entry.label}</span></a>
        : entry.href
        ? <a href={entry.href}>{entry.label}</a>
        : null}
    </>
  ))}
</nav>
