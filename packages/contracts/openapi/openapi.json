{
  "openapi": "3.1.0",
  "info": {
    "title": "Kinship API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/registrations": {
      "post": {
        "operationId": "createFirstWorkspace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Verification required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationAccepted"
                }
              }
            }
          },
          "400": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/email-verifications": {
      "post": {
        "operationId": "verifyEmail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 256
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "writeOnly": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationAccepted"
                }
              }
            }
          },
          "400": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "410": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/email-verification-deliveries": {
      "post": {
        "operationId": "retryVerificationDelivery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Delivery retry accepted without identity disclosure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "accepted"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/application-entry": {
      "post": {
        "operationId": "consumeApplicationEntry",
        "description": "Browser-only one-time application entry. Requires the exact Origin header configured for the public web origin and the HttpOnly kinship_entry cookie. The cookie is SameSite=Strict and is Secure outside explicit loopback HTTP development/test use.",
        "security": [
          {
            "kinship_entry": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must exactly match the configured public web origin.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Narrow application entry context",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "writeOnly": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationEntry"
                }
              }
            }
          },
          "403": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "operationId": "signIn",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must exactly match the configured public web origin.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session created and rotated",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "writeOnly": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticated"
                }
              }
            }
          },
          "202": {
            "description": "MFA challenge required",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "writeOnly": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaRequired"
                }
              }
            }
          },
          "400": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mfa-challenges": {
      "post": {
        "operationId": "completeMfa",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must exactly match the configured public web origin.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "security": [
          {
            "kinship_mfa": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MFA accepted and authenticated session created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "writeOnly": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticated"
                }
              }
            }
          },
          "401": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "410": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-reset-requests": {
      "post": {
        "operationId": "requestPasswordReset",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must exactly match the configured public web origin.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted without identity disclosure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryAccepted"
                }
              }
            }
          },
          "400": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-resets": {
      "post": {
        "operationId": "resetPassword",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must exactly match the configured public web origin.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset and sessions revoked",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "writeOnly": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetAccepted"
                }
              }
            }
          },
          "400": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "410": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "security": [
          {
            "kinship_session": []
          }
        ],
        "parameters": [
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": false,
            "description": "Optional requested workspace; always validated against active membership.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resolved principal and active workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionContext"
                }
              }
            }
          },
          "401": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sign-out": {
      "post": {
        "operationId": "signOut",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must exactly match the configured public web origin.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "security": [
          {
            "kinship_session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current session revoked",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "writeOnly": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedOut"
                }
              }
            }
          },
          "403": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "RFC 9457 problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "kinship_entry": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kinship_entry",
        "description": "One-time HttpOnly browser handoff; SameSite=Strict and Secure outside loopback."
      },
      "kinship_mfa": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kinship_mfa",
        "description": "Short-lived HttpOnly, SameSite=Strict MFA challenge; not an authenticated session."
      },
      "kinship_session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kinship_session",
        "description": "Revocable random browser session; HttpOnly, SameSite=Strict, and Secure outside loopback."
      }
    },
    "schemas": {
      "RegistrationInput": {
        "type": "object",
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "workspaceName"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "workspaceName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "additionalProperties": false
      },
      "RegistrationAccepted": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "verification-required"
          }
        },
        "additionalProperties": false
      },
      "VerificationAccepted": {
        "type": "object",
        "required": [
          "status",
          "next"
        ],
        "properties": {
          "status": {
            "const": "verified"
          },
          "next": {
            "const": "/app"
          }
        },
        "additionalProperties": false
      },
      "ApplicationEntry": {
        "type": "object",
        "required": [
          "status",
          "workspace",
          "member"
        ],
        "properties": {
          "status": {
            "const": "ready"
          },
          "workspace": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "member": {
            "type": "object",
            "required": [
              "id",
              "firstName"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "firstName": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "SignInInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "MfaInput": {
        "type": "object",
        "required": [
          "factor"
        ],
        "properties": {
          "factor": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "writeOnly": true
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "PasswordResetInput": {
        "type": "object",
        "required": [
          "password",
          "token"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "token": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256,
            "writeOnly": true
          }
        },
        "additionalProperties": false
      },
      "Authenticated": {
        "type": "object",
        "required": [
          "status",
          "next",
          "workspace",
          "member"
        ],
        "properties": {
          "status": {
            "const": "authenticated"
          },
          "next": {
            "const": "/app"
          },
          "workspace": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "member": {
            "type": "object",
            "required": [
              "id",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "admin",
                  "member"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "MfaRequired": {
        "type": "object",
        "required": [
          "status",
          "next"
        ],
        "properties": {
          "status": {
            "const": "mfa-required"
          },
          "next": {
            "const": "/auth/mfa"
          }
        },
        "additionalProperties": false
      },
      "RecoveryAccepted": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "additionalProperties": false
      },
      "PasswordResetAccepted": {
        "type": "object",
        "required": [
          "status",
          "next"
        ],
        "properties": {
          "status": {
            "const": "reset"
          },
          "next": {
            "const": "/auth/sign-in"
          }
        },
        "additionalProperties": false
      },
      "SignedOut": {
        "type": "object",
        "required": [
          "status",
          "next"
        ],
        "properties": {
          "status": {
            "const": "signed-out"
          },
          "next": {
            "const": "/auth/sign-in"
          }
        },
        "additionalProperties": false
      },
      "SessionContext": {
        "type": "object",
        "required": [
          "status",
          "principal",
          "workspace",
          "member",
          "workspaces"
        ],
        "properties": {
          "status": {
            "const": "authenticated"
          },
          "principal": {
            "type": "object",
            "required": [
              "userId"
            ],
            "properties": {
              "userId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "additionalProperties": false
          },
          "workspace": {
            "$ref": "#/components/schemas/Authenticated/properties/workspace"
          },
          "member": {
            "$ref": "#/components/schemas/Authenticated/properties/member"
          },
