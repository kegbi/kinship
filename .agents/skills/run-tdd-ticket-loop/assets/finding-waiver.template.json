{
  "id": "<stable finding ID>",
  "lens": "<bug_correctness|performance_reliability|style_maintainability>",
  "severity": "<P2|P3>",
  "location": "<exact path plus line, symbol, route, query, or config key>",
  "expectedBehavior": "<accepted expected behavior>",
  "observedBehavior": "<evidence-backed observed behavior>",
  "reproduction": "<command or deterministic source reproduction>",
  "impact": "<concrete impact>",
  "affectedCriterion": "<acceptance criterion ID>",
  "contractRef": "<declared repository contract reference>",
  "requiredRemediation": "<observable correction being waived>",
  "verification": "<regression test or deterministic check>",
  "status": "waived",
  "waiver": {
    "authority": "<explicit waiver authority>",
    "rationale": "<why the residual risk is accepted>",
    "owner": "<named follow-up owner>",
    "expiresAt": "<future ISO 8601 date-time>"
  }
}
