# Copy to .env and replace this non-secret local placeholder.
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=kinship
POSTGRES_USER=kinship
POSTGRES_PORT=5432
API_PORT=8000
MAILPIT_PORT=8025
SMTP_PORT=1025
WEB_PORT=4321
# development, test, or production; an unset APP_ENV is production.
APP_ENV=development
PUBLIC_WEB_ORIGIN=http://127.0.0.1:4321
# Required when starting the production-like gateway; point to deployment-provided PEM files.
GATEWAY_TLS_CERTIFICATE_PATH=./.tls/gateway.crt
GATEWAY_TLS_PRIVATE_KEY_PATH=./.tls/gateway.key
# Required in production: JSON with activeKeyId and up to 8 base64url keys.
AUTH_MFA_ENCRYPTION_KEYSET=
# Required in production: JSON with activeVersion and 1-8 versioned 32-byte base64url keys.
AUTH_THROTTLE_SUBJECT_KEYSET=
# Required in production: same shape as AUTH_THROTTLE_SUBJECT_KEYSET, with distinct keys.
AUTH_SIGN_IN_DEVICE_KEYSET=
INTEGRATIONS_ENCRYPTION_KEYSET=
INTEGRATIONS_DAV_ENABLED=true
# Minimum response-duration floor for sign-in and MFA; integer 100-2000 milliseconds.
AUTH_MINIMUM_RESPONSE_MS=250
# Local pinned RustFS S3-compatible storage. Replace both credentials outside development.
OBJECT_STORAGE_ACCESS_KEY=kinship
OBJECT_STORAGE_SECRET_KEY=kinship-local-secret
OBJECT_STORAGE_BUCKET=attachments
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=30000
OBJECT_STORAGE_CONSOLE_PORT=9001
# Production mail uses implicit TLS and deployment-provided credentials.
SMTP_FROM=hello@kinship.local
SMTP_HOST=mailpit
SMTP_PASSWORD=
SMTP_SECURITY=plain
SMTP_USERNAME=
# Preflight confirmations stay false until the external production boundaries are verified.
PRIVATE_PRODUCTION_ARCHIVE_ENCRYPTED_AT_REST=false
PRIVATE_PRODUCTION_ARCHIVE_KEY_RECOVERY_VERIFIED=false
PRIVATE_PRODUCTION_SECRET_STORE_READY=false
