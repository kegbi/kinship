# One Astro build feeds both web-facing images. Compose and CI select a target:
#   --target gateway  nginx serving the static client output (public entry)
#   --target web      the private Node renderer for on-demand routes
# Building both targets solves the shared build stage once; the second reuses
# it from the build cache. `web` is last, so it stays the default target. Node
# matches `nodejs` in .tool-versions.
FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web ./apps/web
COPY packages/contracts ./packages/contracts
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm exec astro build --root apps/web

FROM nginx:1.29.1-alpine3.22@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8 AS gateway

COPY gateway/nginx.conf /etc/nginx/nginx.conf
COPY gateway/security_headers.conf /etc/nginx/security_headers.conf
COPY --from=build --chown=nginx:nginx /app/apps/web/dist/client /usr/share/nginx/html
USER nginx

FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS web

WORKDIR /app
ENV HOST=0.0.0.0
ENV PORT=4321
COPY --from=build --chown=node:node /app/apps/web/dist ./apps/web/dist
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
USER node
CMD ["node", "apps/web/dist/server/entry.mjs"]
